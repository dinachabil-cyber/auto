<div class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4" id="cookie-overlay">
    <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full p-6 relative" id="cookie-banner">
        <div class="flex items-start gap-3 mb-4">
            <div class="w-10 h-10 rounded-full bg-[#0b3dff]/10 flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-[#0b3dff]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
            </div>
            <div>
                <h3 class="font-semibold text-gray-900 mb-1">Cookies</h3>
                <p class="text-sm text-gray-600">Ce site utilise des cookies pour améliorer votre expérience. <a href="{{ path('app_politique_confidentialite') }}" class="text-[#0b3dff] underline hover:text-[#0028c4]">En savoir plus</a></p>
            </div>
        </div>
        <div class="flex gap-3">
            <button onclick="setCookieConsent(false)" class="flex-1 px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition">Refuser</button>
            <button onclick="setCookieConsent(true)" class="flex-1 px-4 py-2 bg-[#0b3dff] text-white rounded-lg hover:bg-[#0028c4] transition font-semibold">Accepter</button>
        </div>
    </div>
</div>

<script>
(function () {

    const COOKIE_NAME = "aksamConsent";

    // ---------- COOKIE HELPERS ----------
    function setCookie(name, value, days) {
        const d = new Date();
        d.setTime(d.getTime() + days * 86400000);

        document.cookie =
            name + "=" + encodeURIComponent(value) +
            "; expires=" + d.toUTCString() +
            "; path=/; SameSite=Lax";
    }

    function getCookie(name) {
        const cookies = document.cookie.split("; ");
        for (let c of cookies) {
            if (c.indexOf(name + "=") === 0) {
                return decodeURIComponent(c.substring(name.length + 1));
            }
        }
        return null;
    }

    // ---------- SHOW / HIDE ----------
    function showCookie() {
        document.getElementById("cookie-overlay")?.classList.remove("hidden");
        document.getElementById("cookie-banner")?.classList.remove("hidden");
    }

    function hideCookie() {
        document.getElementById("cookie-overlay")?.classList.add("hidden");
        document.getElementById("cookie-banner")?.classList.add("hidden");
    }

    // ---------- INIT ----------
    function initCookie() {
        const consent = getCookie(COOKIE_NAME);

        if (!consent) {
            showCookie();
        } else {
            hideCookie();
        }
    }

    // ---------- SAVE CONSENT ----------
    window.setCookieConsent = function (accept) {
        setCookie(
            COOKIE_NAME,
            JSON.stringify({
                analytics: accept,
                marketing: accept
            }),
            180
        );

        hideCookie();
    };

    // ---------- BUTTON EVENTS ----------
    document.addEventListener("click", function (e) {
        const btn = e.target.closest("[data-cookie]");
        if (!btn) return;

        if (btn.dataset.cookie === "accept") {
            setCookieConsent(true);
        }

        if (btn.dataset.cookie === "reject") {
            setCookieConsent(false);
        }
    });

    // ---------- START ----------
    document.addEventListener("DOMContentLoaded", initCookie);
    document.addEventListener("turbo:load", initCookie);

})();
</script>