<div id="cookie-overlay" class="hidden fixed inset-0 bg-black/60 z-50 flex items-center justify-center p-4">

    <div id="cookie-banner"
         class="bg-white rounded-3xl shadow-2xl max-w-md w-full p-7 transform transition-all duration-300 scale-95">

        <!-- ICON -->
        <div class="flex items-center gap-3 mb-4">
            <div class="w-12 h-12 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 text-xl">
                🍪
            </div>

            <div>
                <h3 class="text-lg font-bold text-gray-900">We use cookies</h3>
                <p class="text-sm text-gray-500">To improve your experience</p>
            </div>
        </div>

        <!-- TEXT -->
        <p class="text-sm text-gray-600 mb-6 leading-relaxed">
            We use cookies to personalize content, analyze traffic and improve your experience on our website.
        </p>

        <!-- BUTTONS -->
        <div class="flex gap-3">
            <button data-cookie="reject"
                class="flex-1 px-4 py-2.5 border border-gray-300 rounded-xl text-gray-700 hover:bg-gray-100 transition">
                Refuser
            </button>

            <button data-cookie="accept"
                class="flex-1 px-4 py-2.5 bg-blue-600 text-white rounded-xl hover:bg-blue-700 transition font-semibold">
                Accepter
            </button>
        </div>

    </div>
</div>
<script>
(function () {

    const COOKIE_NAME = "aksamConsent";

    // ---------- COOKIE HELPERS ----------
    function setCookie(name, value, days) {
        const d = new Date();
        d.setTime(d.getTime() + days * 86400000);

        document.cookie =
            name + "=" + encodeURIComponent(value) +
            "; expires=" + d.toUTCString() +
            "; path=/; SameSite=Lax";
    }

    function getCookie(name) {
        const cookies = document.cookie.split("; ");
        for (let c of cookies) {
            if (c.indexOf(name + "=") === 0) {
                return decodeURIComponent(c.substring(name.length + 1));
            }
        }
        return null;
    }

    // ---------- SHOW / HIDE ----------
    function showCookie() {
        document.getElementById("cookie-overlay")?.classList.remove("hidden");
        document.getElementById("cookie-banner")?.classList.remove("hidden");
    }

    function hideCookie() {
        document.getElementById("cookie-overlay")?.classList.add("hidden");
        document.getElementById("cookie-banner")?.classList.add("hidden");
    }

    // ---------- INIT ----------
    function initCookie() {
        const consent = getCookie(COOKIE_NAME);

        if (!consent) {
            showCookie();
        } else {
            hideCookie();
        }
    }

    // ---------- SAVE CONSENT ----------
    window.setCookieConsent = function (accept) {
        setCookie(
            COOKIE_NAME,
            JSON.stringify({
                analytics: accept,
                marketing: accept
            }),
            180
        );

        hideCookie();
    };

    // ---------- BUTTON EVENTS ----------
    document.addEventListener("click", function (e) {
        const btn = e.target.closest("[data-cookie]");
        if (!btn) return;

        if (btn.dataset.cookie === "accept") {
            setCookieConsent(true);
        }

        if (btn.dataset.cookie === "reject") {
            setCookieConsent(false);
        }
    });

    // ---------- START ----------
    document.addEventListener("DOMContentLoaded", initCookie);
    document.addEventListener("turbo:load", initCookie);

})();
</script>
<style>
#cookie-banner {
    animation: popup 0.25s ease-out;
}

@keyframes popup {
    from {
        transform: scale(0.9);
        opacity: 0;
    }
    to {
        transform: scale(1);
        opacity: 1;
    }
}
</style>