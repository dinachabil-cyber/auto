{# Reusable form partial - form is passed as a parameter #}
{% set showActivity = showActivity ?? true %}
{% set showPostalCode = showPostalCode ?? true %}

<div class="h-full flex flex-col">
    {{ form_errors(form) }}
    {% if form is defined %}
    <form method="post" action="{{ form_action_url|default(path(app.request.attributes.get('_route'))) }}" class="space-y-5 flex-1 flex flex-col" novalidate data-turbo="false">
        {{ form_widget(form) }}
    </form>
    {% endif %}
</div>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>{{ form_row(form.nom) }}</div>
            <div>{{ form_row(form.prenom) }}</div>
        </div>
        
        <div>{{ form_row(form.raison_sociale) }}</div>
        
        {% if showActivity %}
        <div>{{ form_row(form.activite) }}</div>
        {% endif %}
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>{{ form_row(form.demarrage) }}</div>
            <div>{{ form_row(form.assure) }}</div>
        </div>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>{{ form_row(form.ancienne) }}</div>
            <div>{{ form_row(form.motif_resiliation) }}</div>
        </div>
        
        {% if showPostalCode %}
        <div>{{ form_row(form.code_postal) }}</div>
        {% endif %}
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>{{ form_row(form.telephone) }}</div>
            <div>{{ form_row(form.email) }}</div>
        </div>
        
        <div class="pt-4">
            {{ form_row(form.save) }}
        </div>
    {{ form_end(form) }}
</div>