{# Reusable form partial - form is passed as a parameter #}
{% set showActivity = showActivity ?? true %}
{% set showPostalCode = showPostalCode ?? true %}

<div class="bg-white rounded-2xl shadow-xl p-4 sm:p-6 md:p-8 h-full flex flex-col text-left">
    {{ form_errors(form) }}
    {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'class': 'space-y-4 flex-1 flex flex-col'}}) }}
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>{{ form_row(form.nom) }}</div>
            <div>{{ form_row(form.prenom) }}</div>
        </div>
        
        <div>{{ form_row(form.raison_sociale) }}</div>
        
        {% if showActivity %}
        <div>{{ form_row(form.activite) }}</div>
        {% endif %}
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>{{ form_row(form.demarrage) }}</div>
            <div>{{ form_row(form.assure) }}</div>
        </div>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>{{ form_row(form.ancienne) }}</div>
            <div class="motif-container">{{ form_row(form.motif_resiliation) }}</div>
        </div>
        
        {% if showPostalCode %}
        <div>{{ form_row(form.code_postal) }}</div>
        {% endif %}
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>{{ form_row(form.telephone) }}</div>
            <div>{{ form_row(form.email) }}</div>
        </div>
        
        {{ form_row(form.save) }}
    {{ form_end(form) }}
</div>

<style>
.hidden {
    display: none !important;
}
</style>

<script>
(function() {
    function initMotifResiliation() {
        var ancienneSelect = null;
        var motifContainer = null;
        
        document.querySelectorAll('select').forEach(function(select) {
            if ((select.getAttribute('name') || '').indexOf('[ancienne]') !== -1) {
                ancienneSelect = select;
            }
        });
        
        motifContainer = document.querySelector('.motif-container');
        
        if (!ancienneSelect || !motifContainer) return;
        
        var motifSelect = motifContainer.querySelector('select');
        
        function toggleMotif() {
            if (ancienneSelect.value === 'NON' || ancienneSelect.value === '') {
                motifContainer.classList.add('hidden');
                motifSelect.value = '';
            } else if (ancienneSelect.value === 'OUI') {
                motifContainer.classList.remove('hidden');
            }
        }
        
        ancienneSelect.addEventListener('change', toggleMotif);
        toggleMotif();
    }
    
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initMotifResiliation);
    } else {
        initMotifResiliation();
    }
    document.addEventListener('turbo:load', initMotifResiliation);
})();
</script>