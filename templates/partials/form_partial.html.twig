{# Reusable form partial - form is passed as a parameter #}
{% set showActivity = showActivity|default(true) %}
{% set showPostalCode = showPostalCode|default(true) %}
{% set title = title|default('') %}
{% set subtitle = subtitle|default('') %}

<div class="quote-form-wrapper">

    <div class="form-header">
        Complétez ce formulaire pour obtenir un tarif
    </div>

    <div class="form-card">

        {% if title %}
            <h2 class="text-xl font-bold text-gray-900 mb-2">{{ title }}</h2>
        {% endif %}

        {% if subtitle %}
            <p class="text-sm text-gray-500 mb-6">{{ subtitle }}</p>
        {% endif %}

        {# Global errors #}
        <div class="form-errors">
            {{ form_errors(form) }}
        </div>

        {{ form_start(form, {
            'attr': {
                'novalidate': 'novalidate',
                'class': 'form-body'
            }
        }) }}

        <div class="form-grid">

            {# RAISON SOCIALE #}
            <div class="field-row field-full">
                <span class="field-icon"><i class="fas fa-building"></i></span>
                <div class="field-input">{{ form_row(form.raison_sociale) }}</div>
            </div>

            {% if showActivity %}
            <div class="field-row field-full">
                <span class="field-icon"><i class="fas fa-briefcase"></i></span>
                <div class="field-input">{{ form_row(form.activite) }}</div>
            </div>
            {% endif %}

            <div class="field-row field-full">
                <span class="field-icon"><i class="fas fa-clock"></i></span>
                <div class="field-input">{{ form_row(form.demarrage) }}</div>
            </div>

            <div class="field-row field-full">
                <span class="field-icon"><i class="fas fa-shield-alt"></i></span>
                <div class="field-input">{{ form_row(form.assure) }}</div>
            </div>

            <div class="field-row field-full">
                <span class="field-icon"><i class="fas fa-history"></i></span>
                <div class="field-input">{{ form_row(form.ancienne) }}</div>
            </div>

            <div class="field-row field-full" id="motif-wrapper">
                <span class="field-icon"><i class="fas fa-exclamation-circle"></i></span>
                <div class="field-input">{{ form_row(form.motif) }}</div>
            </div>

            <div class="field-row">
                <span class="field-icon"><i class="fas fa-user"></i></span>
                <div class="field-input">{{ form_row(form.nom) }}</div>
            </div>

            <div class="field-row">
                <span class="field-icon"><i class="fas fa-user"></i></span>
                <div class="field-input">{{ form_row(form.prenom) }}</div>
            </div>

            <div class="field-row">
                <span class="field-icon"><i class="fas fa-phone"></i></span>
                <div class="field-input">{{ form_row(form.tele) }}</div>
            </div>

            {% if showPostalCode %}
            <div class="field-row">
                <span class="field-icon"><i class="fas fa-map-marker-alt"></i></span>
                <div class="field-input">{{ form_row(form.code_postal) }}</div>
            </div>
            {% endif %}

            <div class="field-row field-full">
                <span class="field-icon"><i class="fas fa-envelope"></i></span>
                <div class="field-input">{{ form_row(form.email) }}</div>
            </div>

        </div>

        <div class="form-footer">
            {{ form_row(form.save) }}
        </div>

        {{ form_end(form) }}
    </div>
</div>

<script>
function initToggleMotif() {
    const ancienneSelect = document.querySelector('[name*="[ancienne]"]');
    const motifWrapper = document.getElementById('motif-wrapper');

    if (!ancienneSelect || !motifWrapper) return;

    function toggleMotifField() {
        const motifSelect = motifWrapper.querySelector('select');

        if (ancienneSelect.value === 'NON') {
            motifWrapper.style.display = 'none';
            if (motifSelect) motifSelect.value = '';
        } else {
            motifWrapper.style.display = '';
        }
    }

    toggleMotifField();
    ancienneSelect.addEventListener('change', toggleMotifField);
}

document.addEventListener('DOMContentLoaded', initToggleMotif);
document.addEventListener('turbo:load', initToggleMotif);
</script>

