{# Reusable form partial - form is passed as a parameter #}
{% set showActivity = showActivity|default(true) %}
{% set showPostalCode = showPostalCode|default(true) %}
{% set title = title|default('') %}
{% set subtitle = subtitle|default('') %}

<div class="quote-form-wrapper">
    <div>
        {% if title %}
            <h2 class="text-xl font-bold text-gray-900 mb-2">{{ title }}</h2>
        {% endif %}

        {% if subtitle %}
            <p class="text-sm text-gray-500 mb-6">{{ subtitle }}</p>
        {% endif %}

        {% if form.vars.errors|length > 0 %}
            {% set global_messages = [] %}
            <div class="form-errors" role="alert">
                <ul>
                    {% for error in form.vars.errors %}
                        {% if error.message not in global_messages %}
                            {% set global_messages = global_messages|merge([error.message]) %}
                            <li>
                                <span class="form-error-icon" aria-hidden="true">!</span>
                                {{ error.message }}
                            </li>
                        {% endif %}
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        {{ form_start(form, {
            'attr': {
                'novalidate': 'novalidate',
                'data-turbo': 'false',
                'class': 'form-body'
            }
        }) }}

        <div class="form-grid">
            {% set raison_sociale_has_errors = form.raison_sociale.vars.errors|length > 0 %}
            <div class="field-wrapper field-full">
                <div class="field-row {{ raison_sociale_has_errors ? 'has-error' : '' }}">
                    <span class="field-icon" style="color: #D17B43;" aria-hidden="true"><i class="fas fa-building"></i></span>
                    <div class="field-input">{{ form_widget(form.raison_sociale) }}</div>
                </div>
                {% if raison_sociale_has_errors %}
                    <div class="field-error">{{ form_errors(form.raison_sociale) }}</div>
                {% endif %}
            </div>

            {% if showActivity %}
                {% set activite_has_errors = form.activite.vars.errors|length > 0 %}
                <div class="field-wrapper field-full">
                    <div class="field-row {{ activite_has_errors ? 'has-error' : '' }}">
                        <span class="field-icon" style="color: #D17B43;" aria-hidden="true"><i class="fas fa-briefcase"></i></span>
                        <div class="field-input">{{ form_widget(form.activite) }}</div>
                    </div>
                    {% if activite_has_errors %}
                        <div class="field-error">{{ form_errors(form.activite) }}</div>
                    {% endif %}
                </div>
            {% endif %}

            {% set demarrage_has_errors = form.demarrage.vars.errors|length > 0 %}
            <div class="field-wrapper field-full">
                <div class="field-row {{ demarrage_has_errors ? 'has-error' : '' }}">
                    <span class="field-icon" style="color: #D17B43;" aria-hidden="true"><i class="fas fa-clock"></i></span>
                    <div class="field-input">{{ form_widget(form.demarrage) }}</div>
                </div>
                {% if demarrage_has_errors %}
                    <div class="field-error">{{ form_errors(form.demarrage) }}</div>
                {% endif %}
            </div>

            {% set assure_has_errors = form.assure.vars.errors|length > 0 %}
            <div class="field-wrapper field-full">
                <div class="field-row {{ assure_has_errors ? 'has-error' : '' }}">
                    <span class="field-icon" style="color: #D17B43;" aria-hidden="true"><i class="fas fa-shield-alt"></i></span>
                    <div class="field-input">{{ form_widget(form.assure) }}</div>
                </div>
                {% if assure_has_errors %}
                    <div class="field-error">{{ form_errors(form.assure) }}</div>
                {% endif %}
            </div>

            {% set ancienne_has_errors = form.ancienne.vars.errors|length > 0 %}
            <div class="field-wrapper field-full">
                <div class="field-row {{ ancienne_has_errors ? 'has-error' : '' }}">
                    <span class="field-icon" style="color: #D17B43;" aria-hidden="true"><i class="fas fa-history"></i></span>
                    <div class="field-input">{{ form_widget(form.ancienne) }}</div>
                </div>
                {% if ancienne_has_errors %}
                    <div class="field-error">{{ form_errors(form.ancienne) }}</div>
                {% endif %}
            </div>

            {% set motif_has_errors = form.motif.vars.errors|length > 0 %}
            <div class="field-wrapper field-full" id="motif-wrapper">
                <div class="field-row {{ motif_has_errors ? 'has-error' : '' }}">
                    <span class="field-icon" style="color: #D17B43;" aria-hidden="true"><i class="fas fa-exclamation-circle"></i></span>
                    <div class="field-input">{{ form_widget(form.motif) }}</div>
                </div>
                {% if motif_has_errors %}
                    <div class="field-error">{{ form_errors(form.motif) }}</div>
                {% endif %}
            </div>

            {% set nom_has_errors = form.nom.vars.errors|length > 0 %}
            <div class="field-wrapper">
                <div class="field-row {{ nom_has_errors ? 'has-error' : '' }}">
                    <span class="field-icon" style="color: #D17B43;" aria-hidden="true"><i class="fas fa-user"></i></span>
                    <div class="field-input">{{ form_widget(form.nom) }}</div>
                </div>
                {% if nom_has_errors %}
                    <div class="field-error">{{ form_errors(form.nom) }}</div>
                {% endif %}
            </div>

            {% set prenom_has_errors = form.prenom.vars.errors|length > 0 %}
            <div class="field-wrapper">
                <div class="field-row {{ prenom_has_errors ? 'has-error' : '' }}">
                    <span class="field-icon" style="color: #D17B43;" aria-hidden="true"><i class="fas fa-user"></i></span>
                    <div class="field-input">{{ form_widget(form.prenom) }}</div>
                </div>
                {% if prenom_has_errors %}
                    <div class="field-error">{{ form_errors(form.prenom) }}</div>
                {% endif %}
            </div>

            {% set tele_has_errors = form.tele.vars.errors|length > 0 %}
            <div class="field-wrapper">
                <div class="field-row {{ tele_has_errors ? 'has-error' : '' }}">
                    <span class="field-icon" style="color: #D17B43;" aria-hidden="true"><i class="fas fa-phone"></i></span>
                    <div class="field-input">{{ form_widget(form.tele) }}</div>
                </div>
                {% if tele_has_errors %}
                    <div class="field-error">{{ form_errors(form.tele) }}</div>
                {% endif %}
            </div>

            {% if showPostalCode %}
                {% set code_postal_has_errors = form.code_postal.vars.errors|length > 0 %}
                <div class="field-wrapper">
                    <div class="field-row {{ code_postal_has_errors ? 'has-error' : '' }}">
                        <span class="field-icon" style="color: #D17B43;" aria-hidden="true"><i class="fas fa-map-marker-alt"></i></span>
                        <div class="field-input">{{ form_widget(form.code_postal) }}</div>
                    </div>
                    {% if code_postal_has_errors %}
                        <div class="field-error">{{ form_errors(form.code_postal) }}</div>
                    {% endif %}
                </div>
            {% endif %}

            {% set email_has_errors = form.email.vars.errors|length > 0 %}
            <div class="field-wrapper field-full">
                <div class="field-row {{ email_has_errors ? 'has-error' : '' }}">
                    <span class="field-icon" style="color: #D17B43;" aria-hidden="true"><i class="fas fa-envelope"></i></span>
                    <div class="field-input">{{ form_widget(form.email) }}</div>
                </div>
                {% if email_has_errors %}
                    <div class="field-error">{{ form_errors(form.email) }}</div>
                {% endif %}
            </div>
        </div>

        <div class="form-footer">
            {{ form_row(form.save) }}
        </div>

        {{ form_end(form) }}
    </div>
</div>

<script>
function initToggleMotif() {
    const ancienneSelect = document.querySelector('[name*="[ancienne]"]');
    const motifWrapper = document.getElementById('motif-wrapper');

    if (!ancienneSelect || !motifWrapper) return;

    function toggleMotifField() {
        const motifSelect = motifWrapper.querySelector('select');

        if (ancienneSelect.value === 'NON') {
            motifWrapper.style.display = 'none';
            if (motifSelect) motifSelect.value = '';
        } else {
            motifWrapper.style.display = '';
        }
    }

    toggleMotifField();
    ancienneSelect.addEventListener('change', toggleMotifField);
}

document.addEventListener('DOMContentLoaded', initToggleMotif);
document.addEventListener('turbo:load', initToggleMotif);
</script>
