{# Reusable form partial - form is passed as a parameter #}
{% set showActivity = showActivity|default(true) %}
{% set showPostalCode = showPostalCode|default(true) %}
{% set title = title|default('') %}
{% set subtitle = subtitle|default('') %}

<div class="quote-form-wrapper">

     

     <div  >

         {% if title %}
             <h2 class="text-xl font-bold text-gray-900 mb-2">{{ title }}</h2>
         {% endif %}

         {% if subtitle %}
             <p class="text-sm text-gray-500 mb-6">{{ subtitle }}</p>
         {% endif %}

          {# Global errors #}
          {% if form.vars.errors|length > 0 %}
          <div class="form-errors">
              <ul>
              {% for error in form.vars.errors %}
                  <li>
                      <span class="form-error-icon">⚠️</span>
                      {{ error.message }}
                  </li>
              {% endfor %}
              </ul>
          </div>
          {% endif %}

          {{ form_start(form, {
              'attr': {
                  'novalidate': 'novalidate',
                  'data-turbo': 'false',
                  'class': 'form-body'
              }
          }) }}

         <div class="form-grid">

             {# RAISON SOCIALE #}
             <div class="field-row field-full">
                 <span class="field-icon" style="color: #D17B43;"><i class="fas fa-building"></i></span>
                 <div class="field-input">{{ form_row(form.raison_sociale) }}</div>
             </div>

             {% if showActivity %}
             <div class="field-row field-full">
                 <span class="field-icon" style="color: #D17B43;"><i class="fas fa-briefcase"></i></span>
                 <div class="field-input">{{ form_row(form.activite) }}</div>
             </div>
             {% endif %}

             <div class="field-row field-full">
                 <span class="field-icon" style="color: #D17B43;"><i class="fas fa-clock"></i></span>
                 <div class="field-input">{{ form_row(form.demarrage) }}</div>
             </div>

             <div class="field-row field-full">
                 <span class="field-icon" style="color: #D17B43;"><i class="fas fa-shield-alt"></i></span>
                 <div class="field-input">{{ form_row(form.assure) }}</div>
             </div>

             <div class="field-row field-full">
<span class="field-icon" style="color: #D17B43;"><i class="fas fa-history"></i></span>
                  <div class="field-input">{{ form_row(form.ancienne) }}</div>
              </div>

              <div class="field-row field-full" id="motif-wrapper">
                  <span class="field-icon" style="color: #D17B43;"><i class="fas fa-exclamation-circle"></i></span>
                  <div class="field-input">{{ form_row(form.motif) }}</div>
              </div>

              <div class="field-row">
                  <span class="field-icon" style="color: #D17B43;"><i class="fas fa-user"></i></span>
                  <div class="field-input">{{ form_row(form.nom) }}</div>
              </div>

              <div class="field-row">
                  <span class="field-icon" style="color: #D17B43;"><i class="fas fa-user"></i></span>
                  <div class="field-input">{{ form_row(form.prenom) }}</div>
              </div>

              <div class="field-row">
                  <span class="field-icon" style="color: #D17B43;"><i class="fas fa-phone"></i></span>
                  <div class="field-input">{{ form_row(form.tele) }}</div>
              </div>

              {% if showPostalCode %}
              <div class="field-row">
                  <span class="field-icon" style="color: #D17B43;"><i class="fas fa-map-marker-alt"></i></span>
                  <div class="field-input">{{ form_row(form.code_postal) }}</div>
              </div>
              {% endif %}

              <div class="field-row field-full">
                  <span class="field-icon" style="color: #D17B43;"><i class="fas fa-envelope"></i></span>
                  <div class="field-input">{{ form_row(form.email) }}</div>
              </div>

         </div>

<div class="form-footer">
    {{ form_row(form.save) }}
</div>

        {{ form_end(form) }}
    </div>
</div>

<style>
.quote-form-wrapper .form-footer button,
.quote-form-wrapper .form-footer input[type="submit"] {
    background: #D17B43 !important;
    box-shadow: 0 4px 14px rgba(209, 123, 67, 0.35) !important;
}
.quote-form-wrapper .form-footer button:hover {
    background: #b86535 !important;
}
.quote-form-wrapper .field-row:focus-within {
    border-color: #D17B43 !important;
    box-shadow: 0 0 0 3px rgba(209, 123, 67, 0.2) !important;
}
</style>

<script>
function initToggleMotif() {
    const ancienneSelect = document.querySelector('[name*="[ancienne]"]');
    const motifWrapper = document.getElementById('motif-wrapper');

    if (!ancienneSelect || !motifWrapper) return;

    function toggleMotifField() {
        const motifSelect = motifWrapper.querySelector('select');

        if (ancienneSelect.value === 'NON') {
            motifWrapper.style.display = 'none';
            if (motifSelect) motifSelect.value = '';
        } else {
            motifWrapper.style.display = '';
        }
    }

    toggleMotifField();
    ancienneSelect.addEventListener('change', toggleMotifField);
}

document.addEventListener('DOMContentLoaded', initToggleMotif);
document.addEventListener('turbo:load', initToggleMotif);
</script>


{# Cookie banner script #}

