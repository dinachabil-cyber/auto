<header class="bg-[var(--brand-dark)] sticky top-0 z-50 py-4 shadow-2xl" role="banner">
    <div class="mx-auto sm:px-6 lg:px-8">
        <div class="flex flex-col lg:flex-row items-center justify-between space-y-4 lg:space-y-0">

{# LEFT SECTION → Hidden on mobile, visible from lg screens #}
<div class="hidden lg:flex items-center space-x-4">
    <h1 class="text-xl lg:text-2xl font-semibold text-white leading-snug">
        <span id="header-text"></span>
        <span id="header-cursor"
              class="inline-block w-0.5 h-6 bg-amber-300 ml-1 rounded-sm animate-pulse"
              style="display:none;"></span>
    </h1>

</div>

            {# RIGHT SECTION → Always visible, centered on mobile #}
            <div class="flex items-center space-x-3 w-full justify-center lg:w-auto lg:justify-end">
           <div class="p-2 lg:p-4 bg-accent rounded-xl lg:rounded-2xl shadow-lg">
                        <i class="fas fa-phone text-lg lg:text-2xl text-white"></i>
                    </div>

                <div>
                    <span class="text-xs sm:text-sm text-white/80 block">Conseil personnalisé</span>
                    <a href="tel:0182834800" class="text-lg sm:text-2xl font-bold text-white hover:text-white/80 transition-colors">
                        01 82 83 48 00
                    </a>
                </div>
            </div>

        </div>
    </div>
</header>
<script>
(function() {
    var textEl = document.getElementById('header-text');
    var cursorEl = document.getElementById('header-cursor');

    if (!textEl || !cursorEl) return;

    var fullText = "Professionels de l'automobile, obtenz votre devis en ligne en quelques clics";

    cursorEl.style.display = 'inline';

    function startTyping() {
        textEl.textContent = '';
        var i = 0;
        var int = setInterval(function() {
            textEl.textContent = fullText.substring(0, ++i);
            if (i >= fullText.length) {
                clearInterval(int);
                setTimeout(function() {
                    startTyping(); // ← restart after a pause
                }, 1500); // wait 1.5s before retyping
            }
        }, 35);
    }

    startTyping();
})();
</script>