<header class="bg-[#312a8b] sticky top-0 z-50 py-4 shadow-2xl" role="banner">
    <div class="7xl mx-auto sm:px-6 lg:px-8">
        <div class="flex flex-col lg:flex-row items-center justify-between space-y-4 lg:space-y-0">

            {# LEFT SECTION → always visible #}
            <div class="flex items-center space-x-4">
                <div class="w-10 h-10 sm:w-12 sm:h-12 lg:w-16 lg:h-16 rounded-xl flex items-center justify-center shadow-lg"
                     style="background: rgba(255,255,255,0.2);">
                    <svg class="w-8 h-8 lg:w-10 lg:h-10" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M32 8L50 14L50 32C50 41 42 49 32 53C22 49 14 41 14 32L14 14Z" fill="white"/>
                        <path d="M20 37L20 33L23 27L29 26L35 26L41 27L44 33L44 37Z" fill="#312a8b"/>
                        <path d="M24 27L25.5 31L38.5 31L40 27Z" fill="rgba(49,42,139,0.25)"/>
                        <circle cx="26" cy="37" r="3" fill="#312a8b"/>
                        <circle cx="38" cy="37" r="3" fill="#312a8b"/>
                        <circle cx="26" cy="37" r="1.3" fill="white"/>
                        <circle cx="38" cy="37" r="1.3" fill="white"/>
                    </svg>
                </div>

                <div>
                    <h1 class="text-lg font-semibold text-white max-w-xl">
                        <span id="header-text"></span>
                        <span id="header-cursor"
                              class="inline-block w-0.5 h-5 bg-white ml-0.5 align-middle animate-pulse"
                              style="display:none;"></span>
                    </h1>
                </div>
            </div>

            {# RIGHT SECTION → always visible #}
            <div class="flex items-center space-x-3">
                <div class="p-3 sm:p-4 bg-white/20 rounded-2xl shadow-lg">
                    <svg class="w-6 h-6 sm:w-7 sm:h-7" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M5 6C5 5.45 5.45 5 6 5H9.5L11.5 10.5L9 12C10.2 14.5 13.5 17.8 16 19L17.5 16.5L23 18.5V22C23 22.55 22.55 23 22 23C12.5 23 5 15.5 5 6Z"
                              stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>

                <div>
                    <span class="text-xs sm:text-sm text-white/80 block">Conseil personnalisé</span>
                    <a href="tel:0182834800" class="text-lg sm:text-2xl font-bold text-white hover:text-white/80 transition-colors">
                        01 82 83 48 00
                    </a>
                </div>
            </div>

        </div>
    </div>
</header>

<script>
(function() {
    // Prevent redeclaration on Turbo navigation
    if (window.initHeaderTypewriter) {
        document.addEventListener('turbo:load', window.initHeaderTypewriter);
        return;
    }

    window.headerTypingInterval = null;

    window.initHeaderTypewriter = function() {
        var textRef = document.getElementById('header-text');
        var cursorRef = document.getElementById('header-cursor');
        if (!textRef || !cursorRef) return;

        var fullText = "Quels que soient vos antécédents, obtenez un devis d'assurance pour professionnels auto en quelques clics";

        if (window.headerTypingInterval) {
            clearInterval(window.headerTypingInterval);
            window.headerTypingInterval = null;
        }

        textRef.textContent = '';
        cursorRef.style.display = 'inline';

        var i = 0;

        window.headerTypingInterval = setInterval(function() {
            textRef.textContent += fullText[i];
            i++;

            if (i >= fullText.length) {
                clearInterval(window.headerTypingInterval);
                window.headerTypingInterval = null;

                setTimeout(function() {
                    cursorRef.style.display = 'none';
                }, 800);
            }
        }, 35);
    };

    // Covers all cases: fresh load, Turbo navigation, and script-already-parsed
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', window.initHeaderTypewriter);
    } else {
        window.initHeaderTypewriter();
    }

    document.addEventListener('turbo:load', window.initHeaderTypewriter);
})();
</script>