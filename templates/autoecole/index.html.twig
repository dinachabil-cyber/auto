{% extends 'base.html.twig' %}

{% block title %}Assurance auto-école - RC PRO auto-école{% endblock %}

{% block meta %}
<meta name="description" content="Devis assurance pour auto-école rapide, un comparatif pour RC PRO auto-école en ligne.">
<meta name="keywords" content="Assurance auto-école, RC PRO auto-école, Devis assurance auto-école">
{% endblock %}

{% block body %}
{{ include('partials/header.html.twig') }}

<main id="main-content">
{# ── Hero Section with Form ── #}
<section id="hero" class="py-20 lg:py-32 bg-gradient-to-br from-slate-50 via-slate-100 to-slate-50 hero-pattern relative overflow-hidden">
    <div class="absolute inset-0 scanlines-bg opacity-30"></div>
    
    {# Orbs #}
    <div class="bg-orb w-96 h-96 bg-yellow-300 top-20 left-10 reveal" data-reveal data-reveal-id="orb1" style="animation-delay: 0s;"></div>
    <div class="bg-orb w-80 h-80 bg-blue-300 bottom-20 right-10 reveal" data-reveal data-reveal-id="orb2" style="animation-delay: -5s;"></div>
    <div class="bg-orb w-60 h-60 bg-green-300 top-1/2 left-1/3 reveal" data-reveal data-reveal-id="orb3" style="animation-delay: -10s;"></div>
    
    <div class="container mx-auto px-4 relative z-10">
        <div class="grid lg:grid-cols-2 gap-16 items-stretch">
            {# Form Column #}
            <div class="reveal order-1 lg:order-2" style="transition-delay: 0.1s;">
                <div class="bg-white rounded-3xl shadow-2xl p-8 card-hover border border-gray-100">
                    <div class="text-center mb-8">
                        <div class="w-16 h-16 bg-yellow-400 rounded-2xl mx-auto mb-4 flex items-center justify-center">
                            <i class="fas fa-calculator text-2xl text-dark"></i>
                        </div>
                        <h2 class="text-3xl lg:text-4xl font-bold text-gradient mb-4">Complétez ce formulaire pour obtenir un tarif</h2>
                        <div class="w-20 h-1 bg-yellow-400 mx-auto rounded-full"></div>
                    </div>
                    {{ include('partials/form_partial.html.twig', {
                        'form': form,
                        'showActivity': true,
                        'showPostalCode': true
                    }) }}
                </div>
            </div>
            
            {# Image Column #}
            <div class="reveal order-2 lg:order-1 lg:flex-1" style="transition-delay: 0.2s;">
                <div class="bg-gradient-to-br from-yellow-400 to-yellow-500 rounded-3xl shadow-2xl overflow-hidden h-full min-h-[600px] relative group">
                    <div class="absolute inset-0 scanlines-bg opacity-20"></div>
                    <div class="absolute -inset-4 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-500">
                        <div class="absolute inset-0 rounded-full border-2 border-yellow-400 glow-ring"></div>
                        <div class="absolute inset-4 rounded-full border-2 border-yellow-300 glow-ring" style="animation-direction: reverse;"></div>
                    </div>
                    <img
                        src="https://assurance-professionnels-auto.fr/image/photautoecole.png"
                        alt="Assurance RC Pro auto-école"
                        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                    />
                </div>
            </div>
        </div>
    </div>
</section>

{# ── Section 1 - Définition ── #}
<section class="py-20 bg-surface relative overflow-hidden">
    <div class="container mx-auto px-4">
        <div class="section-head reveal" style="transition-delay: 0.1s;">
            <span class="stag inline-flex items-center gap-2 text-yellow-500 mb-4">
                <svg width="11" height="11" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.09 6.26H21l-5.47 3.97 2.09 6.26L12 14.52l-5.62 3.97 2.09-6.26L3 8.26h6.91z"/></svg>
                I - Assurance auto-école
            </span>
            <h2 class="text-3xl lg:text-4xl font-bold text-dark mb-4">1 - Définition de l'offre</h2>
            <p class="text-lg text-gray-700 leading-relaxed text-center max-w-4xl mx-auto mb-16 reveal" style="transition-delay: 0.2s;">
                L'assurance auto-école est une couverture spécialement conçue pour les professionnels qui exploitent une auto-école et dispensent des cours de conduite. Ce type d'assurance est essentiel pour couvrir les risques spécifiques liés à l'enseignement de la conduite, à la fois pour le matériel (les véhicules de l'auto-école) et pour les élèves, instructeurs et tiers.
            </p>
        </div>
    </div>
</section>

{# ── Section 2 - Garanties ── #}
<section class="py-20 bg-surface relative overflow-hidden" id="garanties">
    <div class="container mx-auto px-4">
        <div class="section-head reveal" style="transition-delay: 0.1s;">
            <span class="stag inline-flex items-center gap-2 text-yellow-500 mb-4">
                <svg width="11" height="11" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.09 6.26H21l-5.47 3.97 2.09 6.26L12 14.52l-5.62 3.97 2.09-6.26L3 8.26h6.91z"/></svg>
                Couvertures
            </span>
            <h2 class="text-3xl lg:text-4xl font-bold text-dark mb-4">2 - Garanties assurance auto-école</h2>
            <p class="text-lg text-gray-700 leading-relaxed mb-12">Les garanties incluses dans une assurance auto-école peuvent couvrir :</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">

            <div class="garantie-card reveal" style="transition-delay: 0.05s;">
                <div class="flex items-center gap-4 sm:gap-6 mb-4">
                    <div class="w-14 h-14 min-w-[56px] flex items-center justify-center bg-gradient-to-br from-yellow-400 to-yellow-400/80 rounded-2xl shadow-lg flex-shrink-0">
                        <i class="fas fa-shield-alt text-white text-xl"></i>
                    </div>
                    <h3 class="text-xl sm:text-2xl font-bold text-dark leading-tight">Responsabilité Civile Professionnelle</h3>
                </div>
                <p class="text-gray-700 leading-relaxed">Couvre les dommages corporels, matériels et immatériels causés aux tiers (élèves, piétons, autres conducteurs, etc.) lors des leçons de conduite.</p>
            </div>

            <div class="garantie-card reveal" style="transition-delay: 0.1s;">
                <div class="flex items-center gap-4 sm:gap-6 mb-4">
                    <div class="w-14 h-14 min-w-[56px] flex items-center justify-center bg-gradient-to-br from-blue-500 to-blue-500/80 rounded-2xl shadow-lg flex-shrink-0">
                        <i class="fas fa-car text-white text-xl"></i>
                    </div>
                    <h3 class="text-xl sm:text-2xl font-bold text-dark leading-tight">Assurance des véhicules</h3>
                </div>
                <p class="text-gray-700 leading-relaxed">Les véhicules de l'auto-école doivent être couverts par une assurance spécifique, car ils sont utilisés dans un cadre d'apprentissage.</p>
            </div>

            <div class="garantie-card reveal" style="transition-delay: 0.15s;">
                <div class="flex items-center gap-4 sm:gap-6 mb-4">
                    <div class="w-14 h-14 min-w-[56px] flex items-center justify-center bg-gradient-to-br from-green-500 to-green-500/80 rounded-2xl shadow-lg flex-shrink-0">
                        <i class="fas fa-chalkboard-teacher text-white text-xl"></i>
                    </div>
                    <h3 class="text-xl sm:text-2xl font-bold text-dark leading-tight">Protection des instructeurs</h3>
                </div>
                <p class="text-gray-700 leading-relaxed">Cette garantie couvre les moniteurs en cas de blessure ou de dommages subis pendant l'exercice de leur activité.</p>
            </div>

            <div class="garantie-card reveal" style="transition-delay: 0.2s;">
                <div class="flex items-center gap-4 sm:gap-6 mb-4">
                    <div class="w-14 h-14 min-w-[56px] flex items-center justify-center bg-gradient-to-br from-purple-500 to-purple-500/80 rounded-2xl shadow-lg flex-shrink-0">
                        <i class="fas fa-graduation-cap text-white text-xl"></i>
                    </div>
                    <h3 class="text-xl sm:text-2xl font-bold text-dark leading-tight">Garantie des élèves conducteurs</h3>
                </div>
                <p class="text-gray-700 leading-relaxed">Comme les élèves n'ont pas encore de permis, ils sont particulièrement exposés au risque d'accidents.</p>
            </div>

            <div class="garantie-card reveal" style="transition-delay: 0.25s;">
                <div class="flex items-center gap-4 sm:gap-6 mb-4">
                    <div class="w-14 h-14 min-w-[56px] flex items-center justify-center bg-gradient-to-br from-pink-500 to-pink-500/80 rounded-2xl shadow-lg flex-shrink-0">
                        <i class="fas fa-building text-white text-xl"></i>
                    </div>
                    <h3 class="text-xl sm:text-2xl font-bold text-dark leading-tight">Garantie des locaux</h3>
                </div>
                <p class="text-gray-700 leading-relaxed">Si l'auto-école dispose de locaux, ils peuvent être couverts contre les risques comme l'incendie, le vol ou les dégâts des eaux.</p>
            </div>

        </div>
        
        <p class="text-center text-gray-600 mt-12 max-w-4xl mx-auto reveal" style="transition-delay: 0.3s;">
            En résumé, l'assurance auto-école offre une protection complète pour les risques spécifiques liés à l'enseignement de la conduite.
        </p>
    </div>
</section>

{# ── Section 3 - CTA Banner ── #}
<section class="py-20 bg-surface relative overflow-hidden">
    <div class="container mx-auto px-4">
        <div class="bg-gradient-to-r from-yellow-400 to-yellow-500 rounded-3xl p-8 lg:p-12 text-center reveal" style="transition-delay: 0.2s;">
            <h2 class="text-3xl lg:text-4xl font-bold text-dark mb-4">II - Devis assurance RC PRO auto-école</h2>
            <p class="text-lg text-dark/80 max-w-2xl mx-auto mb-8">
                Pour obtenir un devis RC PRO auto-école personnalisé et sans engagement, veuillez compléter le formulaire en haut de la page.
            </p>
            <a href="{{ path('app_home') }}" class="inline-block btn-modern bg-gradient-to-r from-yellow-400 to-yellow-500 text-dark font-bold py-4 px-8 rounded-2xl hover:shadow-lg transition-all transform hover:scale-105 gradient-shine">
                <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                Retour à l'accueil
            </a>
        </div>
    </div>
</section>
</main>


{{ include('partials/footer.html.twig') }}

<script>
function initReveal() {
  const io = new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.07 });
  document.querySelectorAll('.reveal').forEach(el => io.observe(el));
}
document.addEventListener('DOMContentLoaded', initReveal);
document.addEventListener('turbo:load', initReveal);
</script>
{% endblock %}