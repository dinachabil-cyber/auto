{% extends 'base.html.twig' %}

{% block title %}Assurance auto-école - RC PRO auto-école{% endblock %}

{% block meta %}
<meta name="description" content="Devis assurance pour auto-école rapide, un comparatif pour RC PRO auto-école en ligne.">
<meta name="keywords" content="Assurance auto-école, RC PRO auto-école, Devis assurance auto-école">
{% endblock %}

{% block body %}
{{ include('partials/header.html.twig') }}

<main id="main-content">
{# ── Hero Section with Form ── #}
<section id="hero" class="py-20 lg:py-32 bg-gradient-to-br from-slate-50 via-slate-100 to-slate-50 hero-pattern relative overflow-hidden">
    <div class="absolute inset-0 scanlines-bg opacity-30"></div>
    
    {# Orbs #}
    <div class="container mx-auto px-4 relative z-10">
        <div class="grid lg:grid-cols-2 gap-16 items-stretch">
            {# Form Column #}
            <div class="reveal order-1 lg:order-2" style="transition-delay: 0.1s;">
                <div class="bg-white rounded-3xl shadow-2xl p-8 card-hover border border-gray-100">
                    <div class="text-center mb-8">
                        <div class="w-16 h-16 bg-[#D17B43] rounded-2xl mx-auto mb-4 flex items-center justify-center">
                            <i class="fas fa-calculator text-2xl text-dark"></i>
                        </div>
                        <h2 class="text-3xl lg:text-4xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-amber-500 to-orange-600 mb-4">Complétez ce formulaire pour obtenir un tarif</h2>
                        <div class="w-20 h-1 bg-[#D17B43] mx-auto rounded-full"></div>
                    </div>
                    {{ include('partials/form_partial.html.twig', {
                        'form': form,
                        'showActivity': true,
                        'showPostalCode': true
                    }) }}
                </div>
            </div>
            
            {# Image Column #}
            <div class="reveal order-2 lg:order-1 lg:flex-1" style="transition-delay: 0.2s;">
                <div class="bg-[#D17B43] rounded-3xl shadow-2xl overflow-hidden h-full min-h-[600px] relative group">
                    <div class="absolute inset-0 scanlines-bg opacity-20"></div>
                    <div class="absolute -inset-4 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-500">
                        <div class="absolute inset-0 rounded-full border-2 border-[#D17B43] glow-ring"></div>
                        <div class="absolute inset-4 rounded-full border-2 border-[#D17B43] glow-ring" style="animation-direction: reverse;"></div>
                    </div>
                    <img
                        src="https://assurance-professionnels-auto.fr/image/photautoecole.png"
                        alt="Assurance RC Pro auto-école"
                        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                    />
                </div>
            </div>
        </div>
    </div>
</section>

{# ── Section 1 - Définition ── #}
<section class="py-20 bg-surface relative overflow-hidden">
    <div class="bg-orb w-64 h-64 bg-[#D17B43]/20 top-10 right-10 reveal" style="animation-delay: 0s;"></div>
    <div class="bg-orb w-48 h-48 bg-blue-200 bottom-10 left-10 reveal" style="animation-delay: -7s;"></div>
    
    <div class="container mx-auto px-4 relative z-10">
        <div class="section-head reveal" style="transition-delay: 0.1s;">
            <h2 class="text-3xl lg:text-4xl font-bold text-dark mb-4"> Assurance auto-école</h2>
            <h3 class="text-2xl font-semibold text-dark mb-4 reveal" style="transition-delay: 0.15s;">1- Définition</h3>
            <p class="text-lg text-gray-700 leading-relaxed text-center max-w-4xl mx-auto mb-16 reveal" style="transition-delay: 0.2s;">
                L'assurance auto-école est une couverture spécialement conçue pour les professionnels qui exploitent une auto-école et dispensent des cours de conduite. Ce type d'assurance est essentiel pour couvrir les risques spécifiques liés à l'enseignement de la conduite, à la fois pour le matériel (les véhicules de l'auto-école) et pour les élèves, instructeurs et tiers.
            </p>
        </div>
    </div>
</section>

{# ── Section 2 - Garanties ── #}
<section class="py-20 bg-surface relative overflow-hidden" id="garanties">
    <div class="bg-orb w-48 h-48 bg-green-200 top-1/2 right-10 reveal" style="animation-delay: -3s;"></div>
    
    <div class="container mx-auto px-4 relative z-10">
        <div class="section-head reveal" style="transition-delay: 0.1s;">
            <h2 class="text-3xl lg:text-4xl font-bold text-dark mb-4">Garanties assurance auto-école</h2>
            <p class="text-lg text-gray-700 leading-relaxed mb-12">Les garanties incluses dans une assurance auto-école peuvent couvrir :</p>
        </div>

        <div class="garanties-list max-w-5xl mx-auto">

            <div class="garantie-card reveal">
                <div class="garantie-front">
                    <div class="garantie-content">
                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                            <div class="garantie-icon yellow">
                                <i class="fas fa-shield-alt"></i>
                            </div>
                            <h3>Responsabilité Civile Professionnelle</h3>
                        </div>
                        <p>Couvre les dommages corporels, matériels et immatériels causés aux tiers (élèves, piétons, autres conducteurs, etc.) lors des leçons de conduite. Par exemple, si un élève cause un accident pendant un cours, la responsabilité civile de l'auto-école est engagée.</p>
                    </div>
                </div>
            </div>

            <div class="garantie-card reveal">
                <div class="garantie-front">
                    <div class="garantie-content">
                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                            <div class="garantie-icon blue">
                                <i class="fas fa-car"></i>
                            </div>
                            <h3>Assurance des véhicules</h3>
                        </div>
                        <p>Les véhicules de l'auto-école doivent être couverts par une assurance spécifique, car ils sont utilisés dans un cadre d'apprentissage. Cette garantie prend en charge les dommages causés aux véhicules de l'auto-école en cas d'accident, de vol ou de vandalisme, ainsi que les dommages causés aux autres véhicules ou biens.</p>
                    </div>
                </div>
            </div>

            <div class="garantie-card reveal">
                <div class="garantie-front">
                    <div class="garantie-content">
                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                            <div class="garantie-icon green">
                                <i class="fas fa-chalkboard-teacher"></i>
                            </div>
                            <h3>Protection des instructeurs</h3>
                        </div>
                        <p>Cette garantie couvre les moniteurs en cas de blessure ou de dommages subis pendant l'exercice de leur activité, y compris en cas de faute de l'élève.</p>
                    </div>
                </div>
            </div>

            <div class="garantie-card reveal">
                <div class="garantie-front">
                    <div class="garantie-content">
                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                            <div class="garantie-icon purple">
                                <i class="fas fa-graduation-cap"></i>
                            </div>
                            <h3>Garantie des élèves conducteurs</h3>
                        </div>
                        <p>Comme les élèves n'ont pas encore de permis, ils sont particulièrement exposés au risque d'accidents. L'assurance auto-école couvre ces risques pendant les leçons de conduite, même si l'élève est responsable de l'accident.</p>
                    </div>
                </div>
            </div>

            <div class="garantie-card reveal">
                <div class="garantie-front">
                    <div class="garantie-content">
                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                            <div class="garantie-icon pink">
                                <i class="fas fa-building"></i>
                            </div>
                            <h3>Garantie des locaux</h3>
                        </div>
                        <p>Si l'auto-école dispose de locaux (pour la théorie ou l'administration), ils peuvent être couverts contre les risques comme l'incendie, le vol ou les dégâts des eaux.</p>
                    </div>
                </div>
            </div>

        </div>
        
        <p class="text-center text-gray-600 mt-12 max-w-4xl mx-auto reveal" style="transition-delay: 0.3s;">
            En résumé, l'assurance auto-école offre une protection complète pour les risques spécifiques liés à l'enseignement de la conduite, incluant à la fois la responsabilité des moniteurs, la sécurité des élèves, ainsi que la protection des véhicules et des locaux de l'auto-école.
        </p>
    </div>
</section>

{# ── Section 3 - CTA Banner ── #}
<section class="py-20 bg-surface relative overflow-hidden">
    <div class="bg-orb w-48 h-48 bg-orange-200 top-10 left-1/4 reveal" style="animation-delay: -2s;"></div>
    
    <div class="container mx-auto px-4 relative z-10">
        <div class="bg-[#2F2EAE] rounded-3xl p-8 lg:p-12 text-center reveal" style="transition-delay: 0.2s;">
               
            <h2 class="text-3xl lg:text-4xl font-bold text-white mb-4"> Devis assurance auto-école</h2>
            <p class="text-lg text-white/90 max-w-2xl mx-auto mb-8">
                Pour obtenir un devis assurance auto-école, veuillez compléter le formulaire à droite de la page. Simple et rapide, obtenez votre devis en ligne en quelques clics.
            </p>
            <a href="{{ path('app_home') }}" class="inline-block bg-white text-[#2F2EAE] font-bold py-4 px-8 rounded-2xl hover:shadow-lg transition-all transform hover:scale-105">
                Retour à l'accueil
            </a>
        </div>
    </div>
</section>
</main>

{{ include('partials/footer.html.twig') }}

<script>
function initReveal() {
  const io = new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.07 });
  document.querySelectorAll('.reveal').forEach(el => io.observe(el));
}
document.addEventListener('DOMContentLoaded', initReveal);
document.addEventListener('turbo:load', initReveal);
</script>
{% endblock %}
