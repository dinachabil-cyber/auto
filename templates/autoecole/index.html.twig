{% extends 'base.html.twig' %}

{% block title %}Assurance auto-école - RC PRO auto-école{% endblock %}

{% block meta %}
<meta name="description" content="Devis assurance pour auto-école rapide, un comparatif pour RC PRO auto-école en ligne.">
<meta name="keywords" content="Assurance auto-école, RC PRO auto-école, Devis assurance auto-école">
{% endblock %}

{% block body %}
{{ include('partials/header.html.twig') }}

<main id="main-content" class="flex-1">
{# ── Hero Section with Form ── #}
<section class="hero">
      <div class="hero-inner">
         
         {# Image Column - Full width background #}
         <div class="hero-image-container">
           <img
             src="https://assurance-professionnels-auto.fr/image/photautoecole.png"
             alt="Assurance RC Pro auto-école"
             loading="lazy"
           />
         </div>
         
         {# Form Column - Positioned on right #}
         <div class="hero-form reveal" style="transition-delay:.15s;">
             {{ include('partials/form_partial.html.twig', {
                 'form': form,
                 'showActivity': true,
                 'showPostalCode': true
             }) }}
         </div>

      </div>
    </section>

   {# ── Section 1 - Définition ── #}
   <section class="intro-strip">
     <div class="section">
       <div class="section-head reveal">
         <span class="stag">
           <svg width="11" height="11" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.09 6.26H21l-5.47 3.97 2.09 6.26L12 14.52l-5.62 3.97 2.09-6.26L3 8.26h6.91z"/></svg>
           I - Assurance auto-école
         </span>
         <h2>1 - Définition de l'offre</h2>
         <p>
           L'assurance auto-école est une couverture spécialement conçue pour les professionnels qui exploitent une auto-école et dispensent des cours de conduite. Ce type d'assurance est essentiel pour couvrir les risques spécifiques liés à l'enseignement de la conduite, à la fois pour le matériel (les véhicules de l'auto-école) et pour les élèves, instructeurs et tiers.
         </p>
       </div>
     </div>
   </section>

   {# ── Section 2 - Garanties (Interactive Grid Setup) ── #}
   <section class="guarantees-section" id="garanties">
     <div class="section">
      
      <div class="section-head reveal">
        <span class="stag">Couvertures</span>
        <h2>2 - Garanties assurance auto-école</h2>
        <p>Les garanties incluses dans une assurance auto-école peuvent couvrir :
</p>
      </div>

      <div class="g-grid">

        {# Card 1 #}
        <div class="g-card reveal" style="transition-delay:.05s">
          <div class="g-card-inner">
            <div class="g-front">
              <div class="g-icon-wrap">🛡️</div>
              <h3>Responsabilité Civile Professionnelle</h3>
              <div class="g-front-hint"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 10l5 5 5-5"/></svg> Survolez pour en savoir plus</div>
            </div>
            <div class="g-back">
              <div class="g-back-icon">🛡️</div>
              <h3>RC Professionnelle</h3>
              <p>Couvre les dommages corporels, matériels et immatériels causés aux tiers (élèves, piétons, autres conducteurs, etc.) lors des leçons de conduite. Par exemple, si un élève cause un accident pendant un cours, la responsabilité civile de l'auto-école est engagée.</p>
            </div>
          </div>
        </div>

        {# Card 2 #}
        <div class="g-card reveal" style="transition-delay:.1s">
          <div class="g-card-inner">
            <div class="g-front">
              <div class="g-icon-wrap">🚗</div>
              <h3>Assurance des véhicules</h3>
              <div class="g-front-hint"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 10l5 5 5-5"/></svg> Survolez pour en savoir plus</div>
            </div>
            <div class="g-back">
              <div class="g-back-icon">🚗</div>
              <h3>Protection Véhicules</h3>
              <p> Les véhicules de l'auto-école doivent être couverts par une assurance spécifique, car ils sont utilisés dans un cadre d'apprentissage. Cette garantie prend en charge les dommages causés aux véhicules de l'auto-école en cas d'accident, de vol ou de vandalisme, ainsi que les dommages causés aux autres véhicules ou biens.</p>
            </div>
          </div>
        </div>

        {# Card 3 #}
        <div class="g-card reveal" style="transition-delay:.15s">
          <div class="g-card-inner">
            <div class="g-front">
              <div class="g-icon-wrap">👨‍🏫</div>
              <h3>Protection des instructeurs</h3>
              <div class="g-front-hint"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 10l5 5 5-5"/></svg> Survolez pour en savoir plus</div>
            </div>
            <div class="g-back">
              <div class="g-back-icon">👨‍🏫</div>
              <h3>Garantie Moniteurs</h3>
              <p> Cette garantie couvre les moniteurs en cas de blessure ou de dommages subis pendant l'exercice de leur activité, y compris en cas de faute de l'élève.</p>
            </div>
          </div>
        </div>

        {# Card 4 #}
        <div class="g-card reveal" style="transition-delay:.2s">
          <div class="g-card-inner">
            <div class="g-front">
              <div class="g-icon-wrap">🎓</div>
              <h3>Garantie des élèves conducteurs</h3>
              <div class="g-front-hint"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 10l5 5 5-5"/></svg> Survolez pour en savoir plus</div>
            </div>
            <div class="g-back">
              <div class="g-back-icon">🎓</div>
              <h3>Élèves Conducteurs</h3>
              <p> Comme les élèves n'ont pas encore de permis, ils sont particulièrement exposés au risque d'accidents. L'assurance auto-école couvre ces risques pendant les leçons de conduite, même si l'élève est responsable de l'accident.</p>
            </div>
          </div>
        </div>

        {# Card 5 #}
        <div class="g-card reveal" style="transition-delay:.25s">
          <div class="g-card-inner">
            <div class="g-front">
              <div class="g-icon-wrap">🏢</div>
              <h3>Garantie des locaux</h3>
              <div class="g-front-hint"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 10l5 5 5-5"/></svg> Survolez pour en savoir plus</div>
            </div>
            <div class="g-back">
              <div class="g-back-icon">🏢</div>
              <h3>Protection Locaux</h3>
              <p> Si l'auto-école dispose de locaux (pour la théorie ou l'administration), ils peuvent être couverts contre les risques comme l'incendie, le vol ou les dégâts des eaux.</p>
            </div>
          </div>
        </div>

      </div>

      <div class="reveal" style="transition-delay:.3s">
        <p style="font-size: .88rem; color: #666; text-align: center; margin-top: 3rem;">
En résumé, l'assurance auto-école offre une protection complète pour les risques spécifiques liés à l'enseignement de la conduite, incluant à la fois la responsabilité des moniteurs, la sécurité des élèves, ainsi que la protection des véhicules et des locaux de l'auto-école.        </p>
      </div>

    </div>
  </section>

  {# ── Section 3 - CTA Banner ── #}
  <section class="cta-wrap">
    <div class="section">
      <div class="cta-box reveal">
        <h2>II - Devis assurance RC PRO auto-école</h2>
        <p>
          Pour obtenir un devis RC PRO auto-école personnalisé et sans engagement, veuillez compléter le formulaire en haut de la page.
        </p>
        <a href="{{ path('app_home') }}" class="btn-primary">
          <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
Retour à l'accueil
         </a>
       </div>
     </div>
   </section>

</main>


{{ include('partials/footer.html.twig') }}
<script>
function initReveal() {
  const io = new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.07 });
  document.querySelectorAll('.reveal').forEach(el => io.observe(el));
}
document.addEventListener('DOMContentLoaded', initReveal);
document.addEventListener('turbo:load', initReveal);
</script>
{% endblock %}