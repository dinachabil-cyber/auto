{% extends 'base.html.twig' %}

{% block title %}Assurance auto-école - RC PRO auto-école{% endblock %}

{% block meta %}
<meta name="description" content="Devis assurance pour auto-école rapide, un comparatif pour RC PRO auto-école en ligne.">
<meta name="keywords" content="Assurance auto-école, RC PRO auto-école, Devis assurance auto-école">
{% endblock %}

{% block body %}
{{ include('partials/header.html.twig') }}

<main id="main-content" class="flex-1">
   {# ── Hero Section with Form ── #}
   <section class="hero">
     <div class="hero-inner">
        
        {# Form Column - First on mobile viewports #}
        <div class="hero-form reveal order-1 lg:order-2" style="transition-delay:.15s">
          <div class="hero-form-card">
            
            <h2>Obtenez votre tarif en 2 minutes</h2>
            <p>Nos conseillers étudient votre dossier et vous répondent rapidement.</p>
            
            {{ include('partials/form_partial.html.twig', {
                'form': form,
                'showActivity': true,
                'showPostalCode': true
            }) }}
          </div>
        </div>

        {# Image Column #}
        <div class="relative h-full min-h-[350px] lg:min-h-[650px] rounded-xl lg:rounded-3xl overflow-hidden shadow-2xl order-2 lg:order-1">
          <img
            src="https://assurance-professionnels-auto.fr/image/photautoecole.png"
            alt="Assurance RC Pro auto-école"
            class="w-full h-full object-cover object-center"
            loading="lazy"
          />
        </div>

     </div>
   </section>

   {# ── Section 1 - Définition ── #}
   <section class="intro-strip">
     <div class="section">
       <div class="section-head reveal">
         <span class="stag">
           <svg width="11" height="11" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.09 6.26H21l-5.47 3.97 2.09 6.26L12 14.52l-5.62 3.97 2.09-6.26L3 8.26h6.91z"/></svg>
           I - Assurance auto-école
         </span>
         <h2>1 - Définition de l'offre</h2>
         <p>
           L'assurance auto-école est une couverture spécialement conçue pour les professionnels qui exploitent une auto-école et dispensent des cours de conduite. Ce type d'assurance est essentiel pour couvrir les risques spécifiques liés à l'enseignement de la conduite, à la fois pour le matériel (les véhicules de l'auto-école) et pour les élèves, instructeurs et tiers.
         </p>
       </div>
     </div>
   </section>

   {# ── Section 2 - Garanties (Interactive Grid Setup) ── #}
   <section class="guarantees-section" id="garanties">
     <div class="section">
      
      <div class="section-head reveal">
        <span class="stag">Couvertures</span>
        <h2>2 - Garanties assurance auto-école</h2>
        <p>Les principales garanties indispensables pour protéger sereinement votre établissement d'enseignement.</p>
      </div>

      <div class="g-grid">

        {# Card 1 #}
        <div class="g-card reveal" style="transition-delay:.05s">
          <div class="g-card-inner">
            <div class="g-front">
              <div class="g-icon-wrap">🛡️</div>
              <h3>Responsabilité Civile Professionnelle</h3>
              <div class="g-front-hint"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 10l5 5 5-5"/></svg> Survolez pour en savoir plus</div>
            </div>
            <div class="g-back">
              <div class="g-back-icon">🛡️</div>
              <h3>RC Professionnelle</h3>
              <p>Couvre les dommages corporels, matériels et immatériels causés aux tiers (élèves, piétons, autres conducteurs) lors des leçons de conduite.</p>
            </div>
          </div>
        </div>

        {# Card 2 #}
        <div class="g-card reveal" style="transition-delay:.1s">
          <div class="g-card-inner">
            <div class="g-front">
              <div class="g-icon-wrap">🚗</div>
              <h3>Assurance des véhicules</h3>
              <div class="g-front-hint"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 10l5 5 5-5"/></svg> Survolez pour en savoir plus</div>
            </div>
            <div class="g-back">
              <div class="g-back-icon">🚗</div>
              <h3>Protection Véhicules</h3>
              <p>Prise en charge spécifique des véhicules double-commande en cas d'accident, vol ou vandalisme lors du cadre d'apprentissage.</p>
            </div>
          </div>
        </div>

        {# Card 3 #}
        <div class="g-card reveal" style="transition-delay:.15s">
          <div class="g-card-inner">
            <div class="g-front">
              <div class="g-icon-wrap">👨‍🏫</div>
              <h3>Protection des instructeurs</h3>
              <div class="g-front-hint"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 10l5 5 5-5"/></svg> Survolez pour en savoir plus</div>
            </div>
            <div class="g-back">
              <div class="g-back-icon">👨‍🏫</div>
              <h3>Garantie Moniteurs</h3>
              <p>Couvre les moniteurs en cas de blessure ou de dommages subis pendant l'exercice de leur activité, y compris en cas de faute de l'élève.</p>
            </div>
          </div>
        </div>

        {# Card 4 #}
        <div class="g-card reveal" style="transition-delay:.2s">
          <div class="g-card-inner">
            <div class="g-front">
              <div class="g-icon-wrap">🎓</div>
              <h3>Garantie des élèves conducteurs</h3>
              <div class="g-front-hint"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 10l5 5 5-5"/></svg> Survolez pour en savoir plus</div>
            </div>
            <div class="g-back">
              <div class="g-back-icon">🎓</div>
              <h3>Élèves Conducteurs</h3>
              <p>Couvre entièrement les élèves non titulaires du permis contre les risques d'accidents pendant toutes leurs heures de leçons de conduite.</p>
            </div>
          </div>
        </div>

        {# Card 5 #}
        <div class="g-card reveal" style="transition-delay:.25s">
          <div class="g-card-inner">
            <div class="g-front">
              <div class="g-icon-wrap">🏢</div>
              <h3>Garantie des locaux</h3>
              <div class="g-front-hint"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 10l5 5 5-5"/></svg> Survolez pour en savoir plus</div>
            </div>
            <div class="g-back">
              <div class="g-back-icon">🏢</div>
              <h3>Protection Locaux</h3>
              <p>Protège vos bureaux et salles de code de théorie contre les risques d'incendie, de vol, de vandalisme ou de dégâts des eaux.</p>
            </div>
          </div>
        </div>

      </div>

      <div class="reveal" style="transition-delay:.3s">
        <p style="font-size: .88rem; color: var(--text-muted); text-align: center; margin-top: 3rem;">
          En résumé, l'assurance auto-école offre une protection complète pour les risques spécifiques liés à l'enseignement de la conduite.
        </p>
      </div>

    </div>
  </section>

  {# ── Section 3 - CTA Banner ── #}
  <section class="cta-wrap">
    <div class="section">
      <div class="cta-box reveal">
        <p style="font-size:.72rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.4);margin-bottom:.75rem">Devis assurance en ligne</p>
        <h2>II - Devis assurance RC PRO auto-école</h2>
        <p>
          Pour obtenir un devis RC PRO auto-école personnalisé et sans engagement, veuillez compléter le formulaire en haut de la page.
        </p>
        <a href="{{ path('app_home') }}" class="btn-primary">
          <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          Retour à l'accueil
        </a>
      </div>
    </div>
  </section>

  {{ include('partials/cookie_banner.html.twig') }}
</main>

{{ include('partials/footer.html.twig') }}

<script>
function initReveal() {
  const io = new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.07 });
  document.querySelectorAll('.reveal').forEach(el => io.observe(el));
}
document.addEventListener('DOMContentLoaded', initReveal);
document.addEventListener('turbo:load', initReveal);
</script>
{% endblock %}