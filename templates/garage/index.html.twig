{% extends 'base.html.twig' %}

{% block title %}Assurance garage automobile - RC PRO garagiste{% endblock %}

{% block meta %}
<meta name="description" content="Devis assurance pour garage automobile rapide, un comparatif pour RC PRO garage auto en ligne.">
<meta name="keywords" content="Assurance garage automobile, RC PRO garage automobile, Devis assurance garage automobile">
{% endblock %}

{% block body %}
{{ include('partials/header.html.twig') }}

<main id="main-content" class="flex-1">
{# ── Hero Section with Form ── #}
<section class="hero">
      <div class="hero-inner">
         
         {# Image Column - Full width background #}
         <div class="hero-image-container">
           <img
             src="https://assurance-professionnels-auto.fr/image/proauto-garage.jpg"
             alt="Assurance garage automobile"
             loading="lazy"
           />
         </div>
         
         {# Form Column - Positioned on right #}
         <div class="hero-form reveal" style="transition-delay:.15s;">
              
             {{ include('partials/form_partial.html.twig', {
                 'form': form,
                 'showActivity': true,
                 'showPostalCode': true
             }) }}
           
         </div>

      </div>
    </section>

   {# ── Section 1 - Définition ── #}
   <section class="intro-strip">
     <div class="section">
       <div class="section-head reveal">
         <span class="stag">
           <svg width="11" height="11" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.09 6.26H21l-5.47 3.97 2.09 6.26L12 14.52l-5.62 3.97 2.09-6.26L3 8.26h6.91z"/></svg>
À propos
      </span>
         <h2>           I - Assurance garage automobile
</h2>
         <h2>1 - Définition</h2>
         <p>
Une assurance pour l’activité de garagiste est une couverture spécialement conçue pour les professionnels du secteur automobile qui exploitent des garages ou tout autre établissement proposant des services liés à la réparation des véhicules. Elle vise à protéger le garagiste contre les risques spécifiques à son activité et à couvrir les responsabilités, les biens, ainsi que les véhicules confiés par ses clients.         </p>
       </div>
     </div>
   </section>

   {# ── Section 2 - Garanties (3D Flip Grid) ── #}
   <section class="guarantees-section" id="garanties">
     <div class="section">
      
      <div class="section-head reveal">
        <span class="stag">Couvertures</span>
        <h2>2 - Garantie RC PRO garage automobile</h2>
        <p>Les garanties principales incluent souvent :</p>
      </div>

      <div class="g-grid">

        {# Card 1 #}
        <div class="g-card reveal" style="transition-delay:.05s">
          <div class="g-card-inner">
            <div class="g-front">
              <div class="g-icon-wrap">🛡️</div>
              <h3>Responsabilité Civile Professionnelle (RC Pro)</h3>
              <div class="g-front-hint"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 10l5 5 5-5"/></svg> Survolez pour en savoir plus</div>
            </div>
            <div class="g-back">
              <div class="g-back-icon">🛡️</div>
              <h3>RC Professionnelle</h3>
              <p> Couvre les dommages matériels, immatériels et corporels causés à des tiers (clients, fournisseurs, visiteurs) dans le cadre de l'activité.</p>
            </div>
          </div>
        </div>

        {# Card 2 #}
        <div class="g-card reveal" style="transition-delay:.1s">
          <div class="g-card-inner">
            <div class="g-front">
              <div class="g-icon-wrap">🏗️</div>
              <h3>Responsabilité Civile Exploitation</h3>
              <div class="g-front-hint"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 10l5 5 5-5"/></svg> Survolez pour en savoir plus</div>
            </div>
            <div class="g-back">
              <div class="g-back-icon">🏗️</div>
              <h3>RC Exploitation</h3>
              <p> Protège le garagiste contre les dommages causés dans le cadre de l'exploitation de l'entreprise (ex. : un client glisse sur une surface huileuse dans le garage)</p>
            </div>
          </div>
        </div>

        {# Card 3 #}
        <div class="g-card reveal" style="transition-delay:.15s">
          <div class="g-card-inner">
            <div class="g-front">
              <div class="g-icon-wrap">🚗</div>
              <h3>Responsabilité Civile après Livraison</h3>
              <div class="g-front-hint"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 10l5 5 5-5"/></svg> Survolez pour en savoir plus</div>
            </div>
            <div class="g-back">
              <div class="g-back-icon">🚗</div>
              <h3>Responsabilité Civile après Livraison </h3>
              <p> Couvre les conséquences d'un sinistre lié à une intervention sur un véhicule (ex. : une réparation défectueuse causant un accident).</p>
            </div>
          </div>
        </div>

        {# Card 4 #}
        <div class="g-card reveal" style="transition-delay:.2s">
          <div class="g-card-inner">
            <div class="g-front">
              <div class="g-icon-wrap">🔧</div>
              <h3>Garantie des biens professionnels</h3>
              <div class="g-front-hint"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 10l5 5 5-5"/></svg> Survolez pour en savoir plus</div>
            </div>
            <div class="g-back">
              <div class="g-back-icon">🔧</div>
              <h3>Biens & Matériels</h3>
              <p> Protège les locaux, équipements, et outils du garage contre des risques tels que l’incendie, le vol, ou les dégâts des eaux.</p>
            </div>
          </div>
        </div>

        {# Card 5 #}
        <div class="g-card reveal" style="transition-delay:.25s">
          <div class="g-card-inner">
            <div class="g-front">
              <div class="g-icon-wrap">⚖️</div>
              <h3>Assurance des véhicules confiés</h3>
              <div class="g-front-hint"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 10l5 5 5-5"/></svg> Survolez pour en savoir plus</div>
            </div>
            <div class="g-back">
              <div class="g-back-icon">⚖️</div>
              <h3>Véhicules Confiés</h3>
              <p>Couvre les véhicules appartenant aux clients lorsqu’ils sont sous la garde du garagiste pour une réparation, un entretien, ou tout autre service.</p>
            </div>
          </div>
        </div>

        {# Card 6 #}
        <div class="g-card reveal" style="transition-delay:.3s">
          <div class="g-card-inner">
            <div class="g-front">
              <div class="g-icon-wrap">💰</div>
              <h3>Assurance essais et déplacements</h3>
              <div class="g-front-hint"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 10l5 5 5-5"/></svg> Survolez pour en savoir plus</div>
            </div>
            <div class="g-back">
              <div class="g-back-icon">💰</div>
              <h3>Essais Routiers</h3>
              <p> Protège les véhicules clients lors d’essais routiers ou de déplacements effectués par les employés du garage.</p>
            </div>
          </div>
        </div>

        {# Card 7 #}
        <div class="g-card reveal" style="transition-delay:.35s">
          <div class="g-card-inner">
            <div class="g-front">
              <div class="g-icon-wrap">🛡️</div>
              <h3>Protection juridique</h3>
              <div class="g-front-hint"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 10l5 5 5-5"/></svg> Survolez pour en savoir plus</div>
            </div>
            <div class="g-back">
              <div class="g-back-icon">🛡️</div>
              <h3>Protection Juridique</h3>
              <p> Offre une assistance et une couverture financière en cas de litige avec un client, un fournisseur, ou une administration.</p>
            </div>
          </div>
        </div>

        {# Card 8 #}
        <div class="g-card reveal" style="transition-delay:.4s">
          <div class="g-card-inner">
            <div class="g-front">
              <div class="g-icon-wrap">📉</div>
              <h3>Perte d'exploitation</h3>
              <div class="g-front-hint"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 10l5 5 5-5"/></svg> Survolez pour en savoir plus</div>
            </div>
            <div class="g-back">
              <div class="g-back-icon">📉</div>
              <h3>Perte d'Exploitation</h3>
              <p> Indemnise les pertes financières liées à une interruption d’activité causée par un sinistre (ex. : incendie du garage).</p>
            </div>
          </div>
        </div>

        {# Card 9 #}
        <div class="g-card reveal" style="transition-delay:.45s">
          <div class="g-card-inner">
            <div class="g-front">
              <div class="g-icon-wrap">🚗</div>
              <h3>Flotte automobile</h3>
              <div class="g-front-hint"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 10l5 5 5-5"/></svg> Survolez pour en savoir plus</div>
            </div>
            <div class="g-back">
              <div class="g-back-icon">🚗</div>
              <h3>Flotte Interne (si applicable) </h3>
              <p> Couvre les véhicules appartenant au garage, comme les véhicules de prêt ou de remplacement</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  {# ── Section 3 - CTA Banner ── #}
  <section class="cta-wrap">
    <div class="section">
      <div class="cta-box reveal">
        <p style="font-size:.72rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.6);margin-bottom:.75rem">Devis assurance en ligne</p>
        <h2>II - Devis assurance garagiste</h2>
        <p>
          Pour obtenir un devis RCPRO garagiste personnalisé, veuillez compléter notre formulaire en haut de la page.
        </p>
        <a href="{{ path('app_home') }}" class="btn-primary">
          <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
Retour à l'accueil
         </a>
       </div>
     </div>
   </section>

</main>


{{ include('partials/footer.html.twig') }}

<script>
function initReveal() {
  const io = new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.07 });
  document.querySelectorAll('.reveal').forEach(el => io.observe(el));
}
document.addEventListener('DOMContentLoaded', initReveal);
document.addEventListener('turbo:load', initReveal);
</script>
{% endblock %}