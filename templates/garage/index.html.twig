{% extends 'base.html.twig' %}

{% block title %}Assurance garage automobile - RC PRO garagiste{% endblock %}

{% block meta %}
<meta name="description" content="Devis assurance pour garage automobile rapide, un comparatif pour RC PRO garage auto en ligne.">
<meta name="keywords" content="Assurance garage automobile, RC PRO garage automobile, Devis assurance garage automobile">
{% endblock %}

{% block body %}
{{ include('partials/header.html.twig') }}

<main id="main-content" class="flex-1">

    {# ================= HERO ================= #}
    <section class="relative min-h-[calc(100vh-4rem)] flex items-center overflow-hidden">

        <div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-center">

                <div class="lg:col-span-6 order-2 lg:order-1 reveal opacity-0 translate-y-6 transition-all duration-700">
                    <div class="relative h-full min-h-[320px] sm:min-h-[440px] lg:min-h-[560px] rounded-2xl overflow-hidden shadow-2xl hover:scale-[1.02] transition-transform duration-500">
                        <img src="https://assurance-professionnels-auto.fr/image/proauto-garage.jpg"
                             alt="Assurance garage automobile"
                             class="w-full h-full object-cover object-center"
                             loading="lazy" />
                    </div>
                </div>

                <div class="lg:col-span-5 lg:col-start-7 order-1 lg:order-2 reveal opacity-0 translate-y-6 transition-all duration-700 delay-100">

                    <div class="glass-effect rounded-3xl p-5 md:p-6 shadow-2xl shadow-indigo-500/10">

                        {{ include('partials/form_partial.html.twig', {
                            'form': form,
                            'title': null,
                            'subtitle': null,
                            'showActivity': true,
                            'showPostalCode': true
                        }) }}

                    </div>

                </div>

            </div>
        </div>
    </section>

    {# ================= DEFINITION ================= #}
    <section class="py-16 bg-white">

        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center reveal opacity-0 translate-y-6 transition-all duration-700">

            <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-5">
                I- Assurance garage automobile
            </h2>

            <h3 class="text-xl font-semibold text-gray-800 mb-3">
                1- Définition
            </h3>

            <p class="text-base text-gray-600 leading-relaxed">
                Une assurance pour l’activité de garagiste est une couverture spécialement conçue pour les professionnels du secteur automobile qui exploitent des garages ou tout autre établissement proposant des services liés à la réparation des véhicules. Elle vise à protéger le garagiste contre les risques spécifiques à son activité et à couvrir les responsabilités, les biens, ainsi que les véhicules confiés par ses clients.
            </p>

        </div>

    </section>

    {# ================= GUARANTEES ================= #}
   <section class="py-16 bg-gray-50" id="garanties">

    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">

        <div class="text-center mb-12 reveal opacity-0 translate-y-6 transition-all duration-700">

            <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-3">
                2- Garantie RC PRO garage automobile
            </h2>

            <p class="text-gray-600">
                Les garanties principales incluent souvent :
            </p>

        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">

            <div class="reveal opacity-0 translate-y-6 transition-all duration-700 delay-100 bg-white rounded-xl p-5 border border-gray-200 hover:border-indigo-300 hover:shadow-lg hover:-translate-y-1">
                <div class="text-2xl mb-3">🛡️</div>
                <h3 class="text-base font-bold text-gray-900 mb-1">
                    Responsabilité Civile Professionnelle (RC Pro)
                </h3>
                <p class="text-sm text-gray-500">
                    Couvre les dommages matériels, immatériels et corporels causés à des tiers (clients, fournisseurs, visiteurs) dans le cadre de l'activité.
                </p>
            </div>

            <div class="reveal opacity-0 translate-y-6 transition-all duration-700 delay-200 bg-white rounded-xl p-5 border border-gray-200 hover:border-indigo-300 hover:shadow-lg hover:-translate-y-1">
                <div class="text-2xl mb-3">🏗️</div>
                <h3 class="text-base font-bold text-gray-900 mb-1">
                    Responsabilité Civile Exploitation
                </h3>
                <p class="text-sm text-gray-500">
                    Protège le garagiste contre les dommages causés dans le cadre de l'exploitation de l'entreprise (ex : client glisse dans le garage).
                </p>
            </div>

            <div class="reveal opacity-0 translate-y-6 transition-all duration-700 delay-300 bg-white rounded-xl p-5 border border-gray-200 hover:border-indigo-300 hover:shadow-lg hover:-translate-y-1">
                <div class="text-2xl mb-3">🚗</div>
                <h3 class="text-base font-bold text-gray-900 mb-1">
                    Responsabilité Civile après Livraison
                </h3>
                <p class="text-sm text-gray-500">
                    Couvre les conséquences d'un sinistre lié à une intervention sur un véhicule (ex : réparation défectueuse causant un accident).
                </p>
            </div>

            <div class="reveal opacity-0 translate-y-6 transition-all duration-700 delay-100 bg-white rounded-xl p-5 border border-gray-200 hover:border-indigo-300 hover:shadow-lg hover:-translate-y-1">
                <div class="text-2xl mb-3">🔧</div>
                <h3 class="text-base font-bold text-gray-900 mb-1">
                    Garantie des biens professionnels
                </h3>
                <p class="text-sm text-gray-500">
                    Protège les locaux, équipements et outils du garage contre incendie, vol ou dégâts des eaux.
                </p>
            </div>

            <div class="reveal opacity-0 translate-y-6 transition-all duration-700 delay-200 bg-white rounded-xl p-5 border border-gray-200 hover:border-indigo-300 hover:shadow-lg hover:-translate-y-1">
                <div class="text-2xl mb-3">⚖️</div>
                <h3 class="text-base font-bold text-gray-900 mb-1">
                    Assurance des véhicules confiés
                </h3>
                <p class="text-sm text-gray-500">
                    Couvre les véhicules des clients lorsqu’ils sont sous la garde du garagiste pour réparation ou entretien.
                </p>
            </div>

            <div class="reveal opacity-0 translate-y-6 transition-all duration-700 delay-300 bg-white rounded-xl p-5 border border-gray-200 hover:border-indigo-300 hover:shadow-lg hover:-translate-y-1">
                <div class="text-2xl mb-3">💰</div>
                <h3 class="text-base font-bold text-gray-900 mb-1">
                    Assurance essais et déplacements / perte d’exploitation
                </h3>
                <p class="text-sm text-gray-500">
                    Protège les véhicules clients lors d’essais routiers ou déplacements effectués par les employés.
                </p>
            </div>

            <div class="reveal opacity-0 translate-y-6 transition-all duration-300 bg-white rounded-xl p-5 border border-gray-200 hover:border-indigo-300 hover:shadow-lg hover:-translate-y-1">
                <div class="text-2xl mb-3">🛡️</div>
                <h3 class="text-base font-bold text-gray-900 mb-1">
                    Protection juridique
                </h3>
                <p class="text-sm text-gray-500">
                    Offre une assistance et une couverture financière en cas de litige avec un client, fournisseur ou administration.
                </p>
            </div>

            <div class="reveal opacity-0 translate-y-6 transition-all duration-300 bg-white rounded-xl p-5 border border-gray-200 hover:border-indigo-300 hover:shadow-lg hover:-translate-y-1">
                <div class="text-2xl mb-3">📉</div>
                <h3 class="text-base font-bold text-gray-900 mb-1">
                    Perte d’exploitation
                </h3>
                <p class="text-sm text-gray-500">
                    Indemnise les pertes financières liées à une interruption d’activité causée par un sinistre.
                </p>
            </div>

            <div class="reveal opacity-0 translate-y-6 transition-all duration-300 bg-white rounded-xl p-5 border border-gray-200 hover:border-indigo-300 hover:shadow-lg hover:-translate-y-1">
                <div class="text-2xl mb-3">🚗</div>
                <h3 class="text-base font-bold text-gray-900 mb-1">
                    Flotte automobile (si applicable)
                </h3>
                <p class="text-sm text-gray-500">
                    Couvre les véhicules appartenant au garage (prêt ou remplacement).
                </p>
            </div>

        </div>

    </div>
</section>

    {# ================= CTA ================= #}
    <section class="py-16">

        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center reveal opacity-0 translate-y-6 transition-all duration-700">

            <div class="glass-effect rounded-2xl p-8 md:p-10 shadow-xl hover:scale-[1.02] transition-transform duration-300">

                <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-3">
                    II- Devis assurance garagiste
                </h2>

                <p class="text-base text-gray-600 mb-5">
                    Pour obtenir un devis RCPRO garagiste veuillez compléter le formulaire en haut de la page.
                </p>

                <a href="{{ path('app_home') }}"
                   class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-indigo-600 to-violet-600 text-white text-base font-semibold rounded-xl hover:shadow-lg hover:scale-105 transition-all duration-300">
                    Retour à l'accueil
                </a>

            </div>

        </div>

    </section>

    {{ include('partials/cookie_banner.html.twig') }}

</main>

{{ include('partials/footer.html.twig') }}

{# ================= ANIMATION SCRIPT ================= #}
<script>
document.addEventListener("DOMContentLoaded", () => {
    const elements = document.querySelectorAll(".reveal");

    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add("opacity-100", "translate-y-0");
                entry.target.classList.remove("opacity-0", "translate-y-6");
            }
        });
    }, {
        threshold: 0.1
    });

    elements.forEach(el => observer.observe(el));
});
</script>

{% endblock %}