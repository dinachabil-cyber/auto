{% extends 'base.html.twig' %}

{% block title %}Assurance garage automobile - RC PRO garagiste{% endblock %}

{% block meta %}
<meta name="description" content="Devis assurance pour garage automobile rapide, un comparatif pour RC PRO garage auto en ligne.">
<meta name="keywords" content="Assurance garage automobile, RC PRO garage automobile, Devis assurance garage automobile">
{% endblock %}

{% block body %}
{{ include('partials/header.html.twig') }}

<main id="main-content" class="flex-1">
   {# ── Hero Section with Form ── #}
   <section class="hero">
     <div class="hero-inner">
        
        {# Form Column - Responsive placement #}
        <div class="hero-form reveal order-1 lg:order-2" style="transition-delay:.15s">
          <div class="hero-form-card">
    
            <h2>Obtenez votre tarif en 2 minutes</h2>
            <p>Nos conseillers étudient votre dossier et vous répondent rapidement.</p>
            
            {{ include('partials/form_partial.html.twig', {
                'form': form,
                'showActivity': true,
                'showPostalCode': true
            }) }}
          </div>
        </div>

        {# Image Column #}
        <div class="relative h-full min-h-[350px] lg:min-h-[650px] rounded-xl lg:rounded-3xl overflow-hidden shadow-2xl order-2 lg:order-1">
          <img
            src="https://assurance-professionnels-auto.fr/image/proauto-garage.jpg"
            alt="Assurance garage automobile"
            class="w-full h-full object-cover object-center"
            loading="lazy"
          />
        </div>

     </div>
   </section>

   {# ── Section 1 - Définition ── #}
   <section class="intro-strip">
     <div class="section">
       <div class="section-head reveal">
         <span class="stag">
           <svg width="11" height="11" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.09 6.26H21l-5.47 3.97 2.09 6.26L12 14.52l-5.62 3.97 2.09-6.26L3 8.26h6.91z"/></svg>
           I - Assurance garage automobile
         </span>
         <h2>1 - Définition de la couverture</h2>
         <p>
           Une assurance pour l'activité de garagiste est une couverture spécialement conçue pour les professionnels du secteur automobile qui exploitent des garages ou tout autre établissement proposant des services liés à la réparation des véhicules. Elle vise à protéger le garagiste contre les risques spécifiques à son activité et à couvrir les responsabilités, les biens, ainsi que les véhicules confiés par ses clients.
         </p>
       </div>
     </div>
   </section>

   {# ── Section 2 - Garanties (3D Flip Grid) ── #}
   <section class="guarantees-section" id="garanties">
     <div class="section">
      
      <div class="section-head reveal">
        <span class="stag">Couvertures</span>
        <h2>2 - Garantie RC PRO garage automobile</h2>
        <p>Les principales garanties indispensables pour protéger et sécuriser l'ensemble de vos interventions quotidiennes.</p>
      </div>

      <div class="g-grid">

        {# Card 1 #}
        <div class="g-card reveal" style="transition-delay:.05s">
          <div class="g-card-inner">
            <div class="g-front">
              <div class="g-icon-wrap">🛡️</div>
              <h3>Responsabilité Civile Professionnelle</h3>
              <div class="g-front-hint"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 10l5 5 5-5"/></svg> Survolez pour en savoir plus</div>
            </div>
            <div class="g-back">
              <div class="g-back-icon">🛡️</div>
              <h3>RC Professionnelle</h3>
              <p>Couvre les dommages matériels, immatériels et corporels causés à des tiers (clients, fournisseurs, visiteurs) dans le cadre direct de vos activités mécaniques.</p>
            </div>
          </div>
        </div>

        {# Card 2 #}
        <div class="g-card reveal" style="transition-delay:.1s">
          <div class="g-card-inner">
            <div class="g-front">
              <div class="g-icon-wrap">🏗️</div>
              <h3>Responsabilité Civile Exploitation</h3>
              <div class="g-front-hint"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 10l5 5 5-5"/></svg> Survolez pour en savoir plus</div>
            </div>
            <div class="g-back">
              <div class="g-back-icon">🏗️</div>
              <h3>RC Exploitation</h3>
              <p>Protège le garagiste contre les incidents involontaires survenant au sein des locaux hors intervention technique (par exemple, un client qui glisse dans l'atelier).</p>
            </div>
          </div>
        </div>

        {# Card 3 #}
        <div class="g-card reveal" style="transition-delay:.15s">
          <div class="g-card-inner">
            <div class="g-front">
              <div class="g-icon-wrap">🚗</div>
              <h3>Responsabilité Civile après Livraison</h3>
              <div class="g-front-hint"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 10l5 5 5-5"/></svg> Survolez pour en savoir plus</div>
            </div>
            <div class="g-back">
              <div class="g-back-icon">🚗</div>
              <h3>RC Après Livraison</h3>
              <p>Couvre les conséquences d'un sinistre ou d'un accident routier causé directement par un défaut de montage ou une intervention mécanique défectueuse.</p>
            </div>
          </div>
        </div>

        {# Card 4 #}
        <div class="g-card reveal" style="transition-delay:.2s">
          <div class="g-card-inner">
            <div class="g-front">
              <div class="g-icon-wrap">🔧</div>
              <h3>Garantie des biens professionnels</h3>
              <div class="g-front-hint"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 10l5 5 5-5"/></svg> Survolez pour en savoir plus</div>
            </div>
            <div class="g-back">
              <div class="g-back-icon">🔧</div>
              <h3>Biens & Matériels</h3>
              <p>Protège l'infrastructure de vos locaux, vos ponts élévateurs, vos outils de diagnostic et équipements contre l'incendie, le vol ou le dégât des eaux.</p>
            </div>
          </div>
        </div>

        {# Card 5 #}
        <div class="g-card reveal" style="transition-delay:.25s">
          <div class="g-card-inner">
            <div class="g-front">
              <div class="g-icon-wrap">⚖️</div>
              <h3>Assurance des véhicules confiés</h3>
              <div class="g-front-hint"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 10l5 5 5-5"/></svg> Survolez pour en savoir plus</div>
            </div>
            <div class="g-back">
              <div class="g-back-icon">⚖️</div>
              <h3>Véhicules Confiés</h3>
              <p>Couvre intégralement les dommages subis par les véhicules de vos clients lorsqu'ils sont sous votre garde pour maintenance ou réparation.</p>
            </div>
          </div>
        </div>

        {# Card 6 #}
        <div class="g-card reveal" style="transition-delay:.3s">
          <div class="g-card-inner">
            <div class="g-front">
              <div class="g-icon-wrap">💰</div>
              <h3>Assurance essais et déplacements</h3>
              <div class="g-front-hint"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 10l5 5 5-5"/></svg> Survolez pour en savoir plus</div>
            </div>
            <div class="g-back">
              <div class="g-back-icon">💰</div>
              <h3>Essais Routiers</h3>
              <p>Assure une couverture complète sur la route lorsque vos employés effectuent des essais techniques ou déplacent les véhicules clients.</p>
            </div>
          </div>
        </div>

        {# Card 7 #}
        <div class="g-card reveal" style="transition-delay:.35s">
          <div class="g-card-inner">
            <div class="g-front">
              <div class="g-icon-wrap">🛡️</div>
              <h3>Protection juridique</h3>
              <div class="g-front-hint"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 10l5 5 5-5"/></svg> Survolez pour en savoir plus</div>
            </div>
            <div class="g-back">
              <div class="g-back-icon">🛡️</div>
              <h3>Protection Juridique</h3>
              <p>Offre une assistance et prend en charge les frais financiers en cas de litige juridique avec un tiers, un fournisseur ou une administration.</p>
            </div>
          </div>
        </div>

        {# Card 8 #}
        <div class="g-card reveal" style="transition-delay:.4s">
          <div class="g-card-inner">
            <div class="g-front">
              <div class="g-icon-wrap">📉</div>
              <h3>Perte d'exploitation</h3>
              <div class="g-front-hint"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 10l5 5 5-5"/></svg> Survolez pour en savoir plus</div>
            </div>
            <div class="g-back">
              <div class="g-back-icon">📉</div>
              <h3>Perte d'Exploitation</h3>
              <p>Indemnise vos pertes financières et charges fixes si un sinistre majeur vous contraint à une interruption totale ou partielle d'activité.</p>
            </div>
          </div>
        </div>

        {# Card 9 #}
        <div class="g-card reveal" style="transition-delay:.45s">
          <div class="g-card-inner">
            <div class="g-front">
              <div class="g-icon-wrap">🚗</div>
              <h3>Flotte automobile</h3>
              <div class="g-front-hint"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 10l5 5 5-5"/></svg> Survolez pour en savoir plus</div>
            </div>
            <div class="g-back">
              <div class="g-back-icon">🚗</div>
              <h3>Flotte Interne</h3>
              <p>Couvre l'ensemble des véhicules appartenant à votre entité commerciale, qu'ils soient dédiés au dépannage ou aux véhicules de courtoisie.</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  {# ── Section 3 - CTA Banner ── #}
  <section class="cta-wrap">
    <div class="section">
      <div class="cta-box reveal">
        <p style="font-size:.72rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.4);margin-bottom:.75rem">Devis assurance en ligne</p>
        <h2>II - Devis assurance garagiste</h2>
        <p>
          Pour obtenir un devis RCPRO garagiste personnalisé, veuillez compléter notre formulaire en haut de la page.
        </p>
        <a href="{{ path('app_home') }}" class="btn-primary">
          <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          Retour à l'accueil
        </a>
      </div>
    </div>
  </section>

  {{ include('partials/cookie_banner.html.twig') }}
</main>

{{ include('partials/footer.html.twig') }}

<script>
function initReveal() {
  const io = new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.07 });
  document.querySelectorAll('.reveal').forEach(el => io.observe(el));
}
document.addEventListener('DOMContentLoaded', initReveal);
document.addEventListener('turbo:load', initReveal);
</script>
{% endblock %}