{% extends 'base.html.twig' %}

{% block title %}Assurance garage automobile - RC PRO garagiste{% endblock %}

{% block meta %}
<meta name="description" content="Devis assurance pour garage automobile rapide, un comparatif pour RC PRO garage auto en ligne.">
<meta name="keywords" content="Assurance garage automobile, RC PRO garage automobile, Devis assurance garage automobile">
{% endblock %}

{% block body %}
{{ include('partials/header.html.twig') }}

<main id="main-content">
{# ── Hero Section with Form ── #}
<section id="hero" class="py-20 lg:py-32 bg-gradient-to-br from-slate-50 via-slate-100 to-slate-50 hero-pattern relative overflow-hidden">
    <div class="absolute inset-0 scanlines-bg opacity-30"></div>
    
    {# Orbs #}
    <div class="container mx-auto px-4 relative z-10">
        <div class="grid lg:grid-cols-2 gap-16 items-stretch">
            {# Form Column #}
            <div class="reveal order-1 lg:order-2" style="transition-delay: 0.1s;">
                <div class="bg-white rounded-3xl shadow-2xl p-8 card-hover border border-gray-100">
                    <div class="text-center mb-8">
                        <div class="w-16 h-16 bg-[#D17B43] rounded-2xl mx-auto mb-4 flex items-center justify-center">
                            <i class="fas fa-tools text-2xl text-dark"></i>
                        </div>
                        <h2 class="text-3xl lg:text-4xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-amber-500 to-orange-600 mb-4">Complétez ce formulaire pour obtenir un tarif</h2>
                        <div class="w-20 h-1 bg-[#D17B43] mx-auto rounded-full"></div>
                    </div>
                    {{ include('partials/form_partial.html.twig', {
                        'form': form,
                        'showActivity': true,
                        'showPostalCode': true
                    }) }}
                </div>
            </div>
            
            {# Image Column #}
            <div class="reveal order-2 lg:order-1 lg:flex-1" style="transition-delay: 0.2s;">
                <div class="bg-[#D17B43] rounded-3xl shadow-2xl overflow-hidden h-full min-h-[600px] relative group">
                    <div class="absolute inset-0 scanlines-bg opacity-20"></div>
                    <div class="absolute -inset-4 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-500">
                        <div class="absolute inset-0 rounded-full border-2 border-[#D17B43] glow-ring"></div>
                        <div class="absolute inset-4 rounded-full border-2 border-[#D17B43] glow-ring" style="animation-direction: reverse;"></div>
                    </div>
                    <img
                        src="https://assurance-professionnels-auto.fr/image/proauto-garage.jpg"
                        alt="Assurance garage automobile"
                        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                    />
                </div>
            </div>
        </div>
    </div>
</section>

{# ── Section 1 - Définition ── #}
<section class="py-20 bg-surface relative overflow-hidden">
    <div class="bg-orb w-64 h-64 bg-[#D17B43]/20 top-10 right-10 reveal" style="animation-delay: 0s;"></div>
    <div class="bg-orb w-48 h-48 bg-blue-200 bottom-10 left-10 reveal" style="animation-delay: -7s;"></div>
    
    <div class="container mx-auto px-4 relative z-10">
        <div class="section-head reveal" style="transition-delay: 0.1s;">
            <span class="stag inline-flex items-center gap-2 text-[#D17B43] mb-4">
                <svg width="11" height="11" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.09 6.26H21l-5.47 3.97 2.09 6.26L12 14.52l-5.62 3.97 2.09-6.26L3 8.26h6.91z"/></svg>
                Assurance garage
            </span>
            <h2 class="text-3xl lg:text-4xl font-bold text-dark mb-4">I - Assurance garage automobile</h2>
            <p class="text-lg text-gray-700 leading-relaxed text-center max-w-4xl mx-auto mb-16 reveal" style="transition-delay: 0.2s;">
                Une assurance pour l'activité de garagiste est une couverture spécialement conçue pour les professionnels du secteur automobile qui exploitent des garages.
            </p>
        </div>
    </div>
</section>

{# ── Section 2 - Garanties ── #}
<section class="py-20 bg-surface relative overflow-hidden" id="garanties">
    <div class="bg-orb w-48 h-48 bg-green-200 top-1/2 right-10 reveal" style="animation-delay: -3s;"></div>
    
    <div class="container mx-auto px-4 relative z-10">
        <div class="section-head reveal" style="transition-delay: 0.1s;">
            <span class="stag inline-flex items-center gap-2 text-[#D17B43] mb-4">
                <svg width="11" height="11" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.09 6.26H21l-5.47 3.97 2.09 6.26L12 14.52l-5.62 3.97 2.09-6.26L3 8.26h6.91z"/></svg>
                Couvertures
            </span>
            <h2 class="text-3xl lg:text-4xl font-bold text-dark mb-4">Garantie RC PRO garage automobile</h2>
            <p class="text-lg text-gray-700 leading-relaxed mb-12">Les principales garanties pour les garagistes.</p>
        </div>

        <div class="garanties-list max-w-5xl mx-auto">

            <div class="garantie-card reveal">
                <div class="garantie-front">
                    <div class="garantie-content">
                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                            <div class="garantie-icon yellow">
                                <i class="fas fa-shield-alt"></i>
                            </div>
                            <h3>Responsabilité Civile Professionnelle</h3>
                        </div>
                        <p>Couvre les dommages matériels, immatériels et corporels causés à des tiers dans le cadre de l'activité.</p>
                    </div>
                </div>
            </div>

            <div class="garantie-card reveal">
                <div class="garantie-front">
                    <div class="garantie-content">
                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                            <div class="garantie-icon blue">
                                <i class="fas fa-industry"></i>
                            </div>
                            <h3>Responsabilité Civile Exploitation</h3>
                        </div>
                        <p>Protège contre les dommages causés dans le cadre de l'exploitation de l'entreprise.</p>
                    </div>
                </div>
            </div>

            <div class="garantie-card reveal">
                <div class="garantie-front">
                    <div class="garantie-content">
                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                            <div class="garantie-icon green">
                                <i class="fas fa-car-crash"></i>
                            </div>
                            <h3>RC After Livraison</h3>
                        </div>
                        <p>Couvre les conséquences d'un sinistre lié à une intervention sur un véhicule.</p>
                    </div>
                </div>
            </div>

            <div class="garantie-card reveal">
                <div class="garantie-front">
                    <div class="garantie-content">
                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                            <div class="garantie-icon purple">
                                <i class="fas fa-tools"></i>
                            </div>
                            <h3>Garantie des biens professionnels</h3>
                        </div>
                        <p>Protège les locaux, équipements et outils du garage contre l'incendie, le vol, les dégâts des eaux.</p>
                    </div>
                </div>
            </div>

            <div class="garantie-card reveal">
                <div class="garantie-front">
                    <div class="garantie-content">
                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                            <div class="garantie-icon pink">
                                <i class="fas fa-weight-hanging"></i>
                            </div>
                            <h3>Véhicules confiés</h3>
                        </div>
                        <p>Couvre les véhicules appartenant aux clients lorsqu'ils sont sous la garde du garagiste.</p>
                    </div>
                </div>
            </div>

            <div class="garantie-card reveal">
                <div class="garantie-front">
                    <div class="garantie-content">
                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                            <div class="garantie-icon" style="background: linear-gradient(135deg,#22d3ee,#06b6d4);">
                                <i class="fas fa-road"></i>
                            </div>
                            <h3>Essais et déplacements</h3>
                        </div>
                        <p>Protège les véhicules clients lors d'essais routiers ou déplacements par employés.</p>
                    </div>
                </div>
            </div>

            <div class="garantie-card reveal">
                <div class="garantie-front">
                    <div class="garantie-content">
                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                            <div class="garantie-icon" style="background: linear-gradient(135deg,#f97316,#fb923c);">
                                <i class="fas fa-gavel"></i>
                            </div>
                            <h3>Protection juridique</h3>
                        </div>
                        <p>Assistance et couverture financière en cas de litige avec un client ou administration.</p>
                    </div>
                </div>
            </div>

            <div class="garantie-card reveal">
                <div class="garantie-front">
                    <div class="garantie-content">
                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                            <div class="garantie-icon" style="background: linear-gradient(135deg,#ef4444,#f87171);">
                                <i class="fas fa-chart-line"></i>
                            </div>
                            <h3>Perte d'exploitation</h3>
                        </div>
                        <p>Indemnise les pertes financières liées à une interruption d'activité causée par un sinistre.</p>
                    </div>
                </div>
            </div>

            <div class="garantie-card reveal">
                <div class="garantie-front">
                    <div class="garantie-content">
                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                            <div class="garantie-icon" style="background: linear-gradient(135deg,#6366f1,#818cf8);">
                                <i class="fas fa-shuttle-van"></i>
                            </div>
                            <h3>Flotte automobile</h3>
                        </div>
                        <p>Couvre les véhicules appartenant au garage, comme les véhicules de prêt ou de remplacement.</p>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

{# ── Section 3 - CTA Banner ── #}
<section class="py-20 bg-surface relative overflow-hidden">
    <div class="bg-orb w-48 h-48 bg-orange-200 bottom-10 right-1/4 reveal" style="animation-delay: -2s;"></div>
    
    <div class="container mx-auto px-4 relative z-10">
<div class="bg-[#2F2EAE] rounded-3xl p-8 lg:p-12 text-center reveal" style="transition-delay: 0.2s;">
             <p class="text-sm font-bold tracking-wider text-white/60 mb-4">DEVIS ASSURANCE EN LIGNE</p>
             <h2 class="text-3xl lg:text-4xl font-bold text-white mb-4">II - Devis assurance garagiste</h2>
             <p class="text-lg text-white/90 max-w-2xl mx-auto mb-8">
                 Pour obtenir un devis RCPRO garagiste personnalisé, veuillez compléter notre formulaire en haut de la page.
             </p>
             <a href="{{ path('app_home') }}" class="inline-block bg-white text-[#2F2EAE] font-bold py-4 px-8 rounded-2xl hover:shadow-lg transition-all transform hover:scale-105">
                 Retour à l'accueil
             </a>
         </div>
    </div>
</section>
</main>

{{ include('partials/footer.html.twig') }}

<script>
function initReveal() {
  const io = new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.07 });
  document.querySelectorAll('.reveal').forEach(el => io.observe(el));
}
document.addEventListener('DOMContentLoaded', initReveal);
document.addEventListener('turbo:load', initReveal);
</script>
{% endblock %}
