{% extends 'base.html.twig' %}

{% block title %}Assurance négociant automobile - RC PRO négociant{% endblock %}

{% block meta %}
<meta name="description" content="Devis assurance pour négociant automobile rapide, un comparatif pour RC Pro négociant auto en ligne.">
<meta name="keywords" content="Assurance négociant automobile, RC Pro négociant automobile, Devis assurance négociant automobile, RC Pro négoce auto, assurance pour vendeur de véhicules">
{% endblock %}

{% block body %}
{{ include('partials/header.html.twig') }}

<main id="main-content">
{# ── Hero Section with Form ── #}
<section id="hero" class="py-20 lg:py-32 bg-gradient-to-br from-slate-50 via-slate-100 to-slate-50 hero-pattern relative overflow-hidden">
    <div class="absolute inset-0 scanlines-bg opacity-30"></div>
    
    {# Orbs #}
    <div class="container mx-auto px-4 relative z-10">
        <div class="grid lg:grid-cols-2 gap-16 items-stretch">
            {# Form Column #}
            <div class="reveal order-1 lg:order-2" style="transition-delay: 0.1s;">
                <div class="bg-white rounded-3xl shadow-2xl p-8 card-hover border border-gray-100">
                    <div class="text-center mb-8">
                        <div class="w-16 h-16 bg-[#D17B43] rounded-2xl mx-auto mb-4 flex items-center justify-center">
                            <i class="fas fa-car text-2xl text-dark"></i>
                        </div>
                        <h2 class="text-3xl lg:text-4xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-amber-500 to-orange-600 mb-4">Complétez ce formulaire pour obtenir un tarif</h2>
                        <div class="w-20 h-1 bg-[#D17B43] mx-auto rounded-full"></div>
                    </div>
                    {{ include('partials/form_partial.html.twig', {
                        'form': form,
                        'showActivity': true,
                        'showPostalCode': true
                    }) }}
                </div>
            </div>
            
            {# Image Column #}
            <div class="reveal order-2 lg:order-1 lg:flex-1" style="transition-delay: 0.2s;">
                <div class="bg-[#D17B43] rounded-3xl shadow-2xl overflow-hidden h-full min-h-[600px] relative group">
                    <div class="absolute inset-0 scanlines-bg opacity-20"></div>
                    <div class="absolute -inset-4 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-500">
                        <div class="absolute inset-0 rounded-full border-2 border-[#D17B43] glow-ring"></div>
                        <div class="absolute inset-4 rounded-full border-2 border-[#D17B43] glow-ring" style="animation-direction: reverse;"></div>
                    </div>
                    <img
                        src="https://assurance-professionnels-auto.fr/image/negocie-auto.jpg"
                        alt="Assurance négociant automobile"
                        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                    />
                </div>
            </div>
        </div>
    </div>
</section>

{# ── Section 1 - Définition ── #}
<section class="py-20 bg-surface relative overflow-hidden">
    <div class="bg-orb w-64 h-64 bg-[#D17B43]/20 top-10 right-10 reveal" style="animation-delay: 0s;"></div>
    <div class="bg-orb w-48 h-48 bg-blue-200 bottom-10 left-10 reveal" style="animation-delay: -7s;"></div>
    
    <div class="container mx-auto px-4 relative z-10">
        <div class="section-head reveal" style="transition-delay: 0.1s;">
            <span class="stag inline-flex items-center gap-2 text-[#D17B43] mb-4">
                <svg width="11" height="11" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.09 6.26H21l-5.47 3.97 2.09 6.26L12 14.52l-5.62 3.97 2.09-6.26L3 8.26h6.91z"/></svg>
                Présentation
            </span>
            <h2 class="text-3xl lg:text-4xl font-bold text-dark mb-4">I - Assurance négociants automobiles</h2>
            <p class="text-lg text-gray-700 leading-relaxed text-center max-w-4xl mx-auto mb-16 reveal" style="transition-delay: 0.2s;">
                Une assurance pour négociant automobile est une police d'assurance spécialement conçue pour couvrir les besoins et les risques associés à l'activité des professionnels du commerce de véhicules automobiles.
            </p>
        </div>
    </div>
</section>

{# ── Section 2 - Garanties ── #}
<section class="py-20 bg-surface relative overflow-hidden" id="garanties">
    <div class="bg-orb w-48 h-48 bg-green-200 top-1/2 right-10 reveal" style="animation-delay: -3s;"></div>
    
    <div class="container mx-auto px-4 relative z-10">
        <div class="section-head reveal" style="transition-delay: 0.1s;">
            <span class="stag inline-flex items-center gap-2 text-[#D17B43] mb-4">
                <svg width="11" height="11" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.09 6.26H21l-5.47 3.97 2.09 6.26L12 14.52l-5.62 3.97 2.09-6.26L3 8.26h6.91z"/></svg>
                Couvertures
            </span>
            <h2 class="text-3xl lg:text-4xl font-bold text-dark mb-4">Garantie assurance RC négociants automobiles</h2>
            <p class="text-lg text-gray-700 leading-relaxed mb-12">Des garanties adaptées aux besoins spécifiques des négociants automobiles.</p>
        </div>

        <div class="garanties-list max-w-5xl mx-auto">

            <div class="garantie-card reveal">
                <div class="garantie-front">
                    <div class="garantie-content">
                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                            <div class="garantie-icon yellow">
                                <i class="fas fa-shield-alt"></i>
                            </div>
                            <h3>Responsabilité Civile Professionnelle</h3>
                        </div>
                        <p>Couvre les dommages causés à des tiers (clients, fournisseurs, visiteurs) dans le cadre de l'activité.</p>
                    </div>
                </div>
            </div>

            <div class="garantie-card reveal">
                <div class="garantie-front">
                    <div class="garantie-content">
                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                            <div class="garantie-icon blue">
                                <i class="fas fa-building"></i>
                            </div>
                            <h3>Garantie des locaux</h3>
                        </div>
                        <p>Protège les locaux professionnels (showroom, atelier, bureaux) contre l'incendie, le vol, le vandalisme.</p>
                    </div>
                </div>
            </div>

            <div class="garantie-card reveal">
                <div class="garantie-front">
                    <div class="garantie-content">
                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                            <div class="garantie-icon green">
                                <i class="fas fa-car"></i>
                            </div>
                            <h3>Véhicules en stock</h3>
                        </div>
                        <p>Couvre les véhicules destinés à la vente contre le vol, l'incendie, le vandalisme.</p>
                    </div>
                </div>
            </div>

            <div class="garantie-card reveal">
                <div class="garantie-front">
                    <div class="garantie-content">
                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                            <div class="garantie-icon purple">
                                <i class="fas fa-truck"></i>
                            </div>
                            <h3>Assurance flotte automobile</h3>
                        </div>
                        <p>Couverture pour les véhicules utilisés pour le transport, les essais, les livraisons.</p>
                    </div>
                </div>
            </div>

            <div class="garantie-card reveal">
                <div class="garantie-front">
                    <div class="garantie-content">
                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                            <div class="garantie-icon pink">
                                <i class="fas fa-balance-scale"></i>
                            </div>
                            <h3>Protection juridique</h3>
                        </div>
                        <p>Assistance et couverture financière en cas de litige avec clients ou fournisseurs.</p>
                    </div>
                </div>
            </div>

            <div class="garantie-card reveal">
                <div class="garantie-front">
                    <div class="garantie-content">
                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                            <div class="garantie-icon" style="background: linear-gradient(135deg,#22d3ee,#06b6d4);">
                                <i class="fas fa-road"></i>
                            </div>
                            <h3>Essais et démonstrations</h3>
                        </div>
                        <p>Couverture des risques lors des essais clients et démonstrations de véhicules.</p>
                    </div>
                </div>
            </div>

            <div class="garantie-card reveal">
                <div class="garantie-front">
                    <div class="garantie-content">
                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                            <div class="garantie-icon" style="background: linear-gradient(135deg,#f97316,#fb923c);">
                                <i class="fas fa-chart-line"></i>
                            </div>
                            <h3>Perte d'exploitation</h3>
                        </div>
                        <p>Indemnise les pertes financières dues à une interruption temporaire d'activité.</p>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

{# ── Section 3 - CTA Banner ── #}
<section class="py-20 bg-surface relative overflow-hidden">
    <div class="bg-orb w-48 h-48 bg-orange-200 bottom-10 right-1/4 reveal" style="animation-delay: -2s;"></div>
    
    <div class="container mx-auto px-4 relative z-10">
        <div class="bg-[#4799EA] rounded-3xl p-8 lg:p-12 text-center reveal" style="transition-delay: 0.2s;">
            <p class="text-sm font-bold tracking-wider text-white/60 mb-4">DEVIS ASSURANCE EN LIGNE</p>
            <h2 class="text-3xl lg:text-4xl font-bold text-white mb-4">Devis assurance négociants automobiles</h2>
            <p class="text-lg text-white/90 max-w-2xl mx-auto mb-8">
                Pour obtenir un devis, veuillez compléter le formulaire en haut de la page. Simple et rapide.
            </p>
            <a href="{{ path('app_home') }}" class="inline-block bg-white text-[#4799EA] font-bold py-4 px-8 rounded-2xl hover:shadow-lg transition-all transform hover:scale-105">
                Retour à l'accueil
            </a>
        </div>
    </div>
</section>
</main>

{{ include('partials/footer.html.twig') }}

<script>
function initReveal() {
  const io = new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.07 });
  document.querySelectorAll('.reveal').forEach(el => io.observe(el));
}
document.addEventListener('DOMContentLoaded', initReveal);
document.addEventListener('turbo:load', initReveal);
</script>
{% endblock %}
