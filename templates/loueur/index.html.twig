{% extends 'base.html.twig' %}

{% block title %}Assurance loueur de voiture - RC PRO location{% endblock %}

{% block meta %}
<meta name="description" content="Devis assurance pour loueur de voiture rapide, un comparatif pour RC PRO location de voiture en ligne.">
<meta name="keywords" content="Assurance loueur de voiture, RC PRO loueur voiture, Devis assurance loueur véhicule, Assurance flotte location">
{% endblock %}

{% block body %}
{{ include('partials/header.html.twig') }}

<main id="main-content" class="flex-1">
   {# ── Hero Section with Form ── #}
   <section class="hero">
     <div class="hero-inner">
        
        {# Form Column #}
        <div class="hero-form reveal order-1 lg:order-2" style="transition-delay:.15s">
          <div class="hero-form-card">
          
            <h2>Obtenez votre tarif en 2 minutes</h2>
            <p>Nos conseillers étudient votre dossier et vous répondent rapidement.</p>
            
            {{ include('partials/form_partial.html.twig', {
                'form': form,
                'showActivity': true,
                'showPostalCode': true
            }) }}
          </div>
        </div>

        {# Image Column #}
        <div class="relative h-full min-h-[350px] lg:min-h-[650px] rounded-xl lg:rounded-3xl overflow-hidden shadow-2xl order-2 lg:order-1">
          <img
            src="https://assurance-professionnels-auto.fr/image/loueur-voiture.jpg"
            alt="Assurance Flotte Loueur de Voiture"
            class="w-full h-full object-cover object-center"
            loading="lazy"
          />
        </div>

     </div>
   </section>

   {# ── Section 1 - Définition ── #}
   <section class="intro-strip">
     <div class="section">
       <div class="section-head reveal">
         <span class="stag">
           <svg width="11" height="11" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.09 6.26H21l-5.47 3.97 2.09 6.26L12 14.52l-5.62 3.97 2.09-6.26L3 8.26h6.91z"/></svg>
           I - Assurance Loueur
         </span>
         <h2>1 - Définition de l'offre location</h2>
         <p>
           L'assurance pour loueur de véhicules est une couverture sur-mesure développée spécifiquement pour protéger les flottes automobiles de location (courte ou longue durée). Elle protège activement l'entreprise contre les risques financiers majeurs liés aux sinistres subis par les conducteurs clients, tout en garantissant la pérennité de votre parc auto.
         </p>
       </div>
     </div>
   </section>

   {# ── Section 2 - Garanties (Interactive Grid Setup) ── #}
   <section class="guarantees-section" id="garanties">
     <div class="section">
      
      <div class="section-head reveal">
        <span class="stag">Couvertures</span>
        <h2>2 - Garanties assurance loueur de véhicules</h2>
        <p>Découvrez les protections essentielles pour sécuriser vos véhicules en circulation et votre activité de location.</p>
      </div>

      <div class="g-grid">

        {# Card 1 #}
        <div class="g-card reveal" style="transition-delay:.05s">
          <div class="g-card-inner">
            <div class="g-front">
              <div class="g-icon-wrap">🛡️</div>
              <h3>Responsabilité Civile Circulation</h3>
              <div class="g-front-hint"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 10l5 5 5-5"/></svg> Survolez pour en savoir plus</div>
            </div>
            <div class="g-back">
              <div class="g-back-icon">🛡️</div>
              <h3>RC Flotte de Location</h3>
              <p>Garantie obligatoire couvrant l'ensemble des dommages matériels et corporels causés aux tiers par vos clients au volant de vos véhicules loués.</p>
            </div>
          </div>
        </div>

        {# Card 2 #}
        <div class="g-card reveal" style="transition-delay:.1s">
          <div class="g-card-inner">
            <div class="g-front">
              <div class="g-icon-wrap">🚗</div>
              <h3>Garantie Dommages Tous Risques</h3>
              <div class="g-front-hint"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 10l5 5 5-5"/></svg> Survolez pour en savoir plus</div>
            </div>
            <div class="g-back">
              <div class="g-back-icon">🚗</div>
              <h3>Dommages Matériels</h3>
              <p>Prend en charge les réparations de vos véhicules en cas d'accident responsable, de collision sans tiers identifié ou de sortie de route du locataire.</p>
            </div>
          </div>
        </div>

        {# Card 3 #}
        <div class="g-card reveal" style="transition-delay:.15s">
          <div class="g-card-inner">
            <div class="g-front">
              <div class="g-icon-wrap">❌</div>
              <h3>Vol, Détournement et Vandalisme</h3>
              <div class="g-front-hint"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 10l5 5 5-5"/></svg> Survolez pour en savoir plus</div>
            </div>
            <div class="g-back">
              <div class="g-back-icon">❌</div>
              <h3>Protection Vol & Abus</h3>
              <p>Indemnisation de la valeur de votre véhicule en cas de vol caractérisé, d'actes de vandalisme ou de non-restitution (détournement) par le locataire.</p>
            </div>
          </div>
        </div>

        {# Card 4 #}
        <div class="g-card reveal" style="transition-delay:.2s">
          <div class="g-card-inner">
            <div class="g-front">
              <div class="g-icon-wrap">💼</div>
              <h3>RC Professionnelle Loueur</h3>
              <div class="g-front-hint"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 10l5 5 5-5"/></svg> Survolez pour en savoir plus</div>
            </div>
            <div class="g-back">
              <div class="g-back-icon">💼</div>
              <h3>RC Pro Activité</h3>
              <p>Protège votre entreprise contre les litiges juridiques et préjudices découlant de votre activité commerciale (erreur dans le contrat, défaut d'entretien mécanique).</p>
            </div>
          </div>
        </div>

        {# Card 5 #}
        <div class="g-card reveal" style="transition-delay:.25s">
          <div class="g-card-inner">
            <div class="g-front">
              <div class="g-icon-wrap">📉</div>
              <h3>Perte d'Exploitation Flotte</h3>
              <div class="g-front-hint"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 10l5 5 5-5"/></svg> Survolez pour en savoir plus</div>
            </div>
            <div class="g-back">
              <div class="g-back-icon">📉</div>
              <h3>Immobilisation Véhicule</h3>
              <p>Compense la perte de revenus financiers liée à l'immobilisation prolongée de vos véhicules au garage suite à un sinistre couvert.</p>
            </div>
          </div>
        </div>

      </div>

      <div class="reveal" style="transition-delay:.3s">
        <p style="font-size: .88rem; color: var(--text-muted); text-align: center; margin-top: 3rem;">
          En résumé, l'assurance loueur sécurise de bout en bout l'exploitation de votre parc automobile contre les aléas de la route.
        </p>
      </div>

    </div>
  </section>

  {# ── Section 3 - CTA Banner ── #}
  <section class="cta-wrap">
    <div class="section">
      <div class="cta-box reveal">
        <p style="font-size:.72rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.4);margin-bottom:.75rem">Devis assurance en ligne</p>
        <h2>II - Devis assurance RC PRO loueur de voiture</h2>
        <p>
          Pour obtenir un devis personnalisé pour votre flotte de véhicules légers ou d'utilitaires, complétez notre formulaire de tarification rapide en haut de page.
        </p>
        <a href="{{ path('app_home') }}" class="btn-primary">
          <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          Retour à l'accueil
        </a>
      </div>
    </div>
  </section>

  {{ include('partials/cookie_banner.html.twig') }}
</main>

{{ include('partials/footer.html.twig') }}

<script>
function initReveal() {
  const io = new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.07 });
  document.querySelectorAll('.reveal').forEach(el => io.observe(el));
}
document.addEventListener('DOMContentLoaded', initReveal);
document.addEventListener('turbo:load', initReveal);
</script>
{% endblock %}