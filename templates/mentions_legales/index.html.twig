<style>
@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap');

/* ── Design Tokens & Base Theme ────────────────────────── */
:root {
  --brand-primary: #312a8b;
  --brand-gradient: linear-gradient(135deg, #312a8b 0%, #4f46e5 100%);
  --text-dark: #1f2937;
  --text-muted: #4b5563;
  --bg-light: #f9fafb;
  --accent-gold: linear-gradient(90deg, #fbbf24 0%, #f59e0b 100%);
}

.legal-body {
  font-family: 'Plus Jakarta Sans', sans-serif;
  color: var(--text-dark);
  background-color: var(--bg-light);
}

/* ── Custom Pattern & Background Effects ────────────────── */
.hero-pattern {
  background-color: #ffffff;
  background-image: radial-gradient(#4f46e5 0.5px, transparent 0.5px), radial-gradient(#4f46e5 0.5px, #ffffff 0.5px);
  background-size: 20px 20px;
  background-position: 0 0, 10px 10px;
  background-opacity: 0.02;
}

.scanlines-bg {
  background: linear-gradient(
    rgba(18, 16, 16, 0) 50%, 
    rgba(0, 0, 0, 0.03) 50%
  );
  background-size: 100% 4px;
}

/* ── Typography & Gradients ────────────────────────────── */
.text-gradient {
  background: var(--brand-gradient);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  display: inline-block;
}

/* ── Article / Prose Layout Fixes ──────────────────────── */
.legal-prose h2 {
  color: var(--brand-primary);
  border-left: 4px solid #f59e0b;
  padding-left: 12px;
  margin-top: 2.5rem;
}

.legal-prose h3 {
  color: #374151;
  margin-top: 1.5rem;
  font-weight: 600;
}

.legal-prose p {
  line-height: 1.75;
  color: var(--text-muted);
}

.legal-prose ul li {
  position: relative;
  padding-left: 1.5rem;
  list-style-type: none;
}

.legal-prose ul li::before {
  content: "•";
  color: #f59e0b;
  font-weight: bold;
  font-size: 1.25rem;
  position: absolute;
  left: 0;
  top: -2px;
}
</style>

