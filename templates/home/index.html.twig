{# ── 3D Engine Interactivity Script ── #}
<script>
function initAdvanced3DEngine() {
    const space = document.querySelectorAll(".node-3d");
    if (window.innerWidth < 1024) return; // Keeps rendering performant on mobile devices

    space.forEach(node => {
        node.addEventListener("mousemove", (e) => {
            const boundaries = node.getBoundingClientRect();
            const coordinateX = e.clientX - boundaries.left - boundaries.width / 2;
            const coordinateY = e.clientY - boundaries.top - boundaries.height / 2;
            
            // Map relative mouse position to perspective degrees
            const rotateX = -(coordinateY / (boundaries.height / 2)) * 14;
            const rotateY = (coordinateX / (boundaries.width / 2)) * 14;

            node.style.transform = `translateZ(40px) scale(1.04) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
        });

        node.addEventListener("mouseleave", () => {
            node.style.transform = "translateZ(0px) scale(1) rotateX(0deg) rotateY(0deg)";
        });
    });
}

document.addEventListener('DOMContentLoaded', initAdvanced3DEngine);
if (window.Turbo) {
    document.addEventListener('turbo:load', initAdvanced3DEngine);
}
</script>

{# ── Stylesheets for 3D Viewports ── #}
<style>
.perspective-container {
    perspective: 1600px;
}

@media (min-width: 1024px) {
    .matrix-3d-grid {
        transform: rotateX(8deg) rotateY(-4deg) rotateZ(0.5deg);
        transform-style: preserve-3d;
        transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .matrix-3d-grid:hover {
        transform: rotateX(0deg) rotateY(0deg) rotateZ(0deg);
    }
}

.node-3d {
    transform-style: preserve-3d;
    transform: translateZ(0px);
    transition: transform 0.25s cubic-bezier(0.25, 1, 0.5, 1), border-color 0.3s, box-shadow 0.4s;
}

.node-3d:hover {
    box-shadow: 0 30px 50px -10px rgba(var(--glow-color), 0.15), 
                0 10px 20px -5px rgba(0, 0, 0, 0.04);
}

.animate-pulse-slow {
    animation: glow-pulse 8s ease-in-out infinite;
}

.animate-spin-slow {
    animation: spin-clockwise 15s linear infinite;
}

@keyframes glow-pulse {
    0%, 100% { transform: scale(1) opacity: 0.8; }
    50% { transform: scale(1.1) opacity: 1; }
}

@keyframes spin-clockwise {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}
</style>
