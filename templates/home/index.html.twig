{% extends 'base.html.twig' %}

{% block title %}Aksam Assurance — Assurance Professionnels Auto{% endblock %}

{% block body %}
{{ include('partials/header.html.twig') }}

<main id="main-content">
{# ── Hero ── #}
<section class="hero">
    <div class="hero-inner">

        {# Form - Comes FIRST on mobile #}
        <div class="hero-form reveal order-1 lg:order-2" style="transition-delay:.15s">
            <div class="hero-form-card">
                <h2>Obtenez votre tarif en 2 minutes</h2>
                <p>Nos conseillers étudient votre dossier et vous répondent rapidement.</p>
                
                {{ include('partials/form_partial.html.twig', {
                    'form': form,
                    'showActivity': true,
                    'showPostalCode': true
                }) }}
            </div>
        </div>

        {# Image - Comes AFTER form on mobile #}
        <div class="relative h-full min-h-[350px] lg:min-h-[650px] rounded-xl lg:rounded-3xl overflow-hidden shadow-2xl order-2 lg:order-1">
            <img
                src="{{ asset('image/home.png') }}"
                alt="Conducteur professionnel"
                class="w-full h-full object-cover object-center"
                loading="lazy"
            />
        </div>

    </div>
</section>
  {# ── Intro ── #}
  <section class="intro-strip">
    <div class="section">
      <div class="section-head reveal">
        <span class="stag">
          <svg width="11" height="11" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.09 6.26H21l-5.47 3.97 2.09 6.26L12 14.52l-5.62 3.97 2.09-6.26L3 8.26h6.91z"/></svg>
          À propos
        </span>
        <h2>Assurance des professionnels de l'automobile</h2>
        <p>
          Conçue spécialement pour les entreprises du secteur automobile, l'assurance multirisque professionnelle protège les professionnels contre les risques spécifiques liés à leurs activités — des ateliers de réparation aux auto-écoles, en passant par les concessionnaires et loueurs.
        </p>
      </div>
    </div>
  </section>

  {# ── Activities ── #}
  <section class="activities-bg" id="activites">
    <div class="section">
      <div class="section-head reveal">
        <span class="stag">Métiers couverts</span>
        <h2>Assurance MRP automobile</h2>
        <p>Que vous soyez garagiste, auto-école, négociant ou loueur, nous avons une solution adaptée à votre métier.</p>
      </div>

      <div class="activity-grid">

        <a href="{{ path('app_garage') }}" class="act-card reveal" style="transition-delay:.05s">
          <div class="act-icon">🏠</div>
          <div class="act-title">Garagistes</div>
          <div class="act-desc">Ateliers de réparation, entretien et maintenance automobile.</div>
          <span class="act-link">En savoir plus <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
        </a>

        <div class="act-card reveal" style="transition-delay:.1s">
          <div class="act-icon">🏢</div>
          <div class="act-title">Concessionnaires</div>
          <div class="act-desc">Vente de véhicules neufs et occasions.</div>
        </div>

        <a href="{{ path('app_loueur') }}" class="act-card reveal" style="transition-delay:.15s">
          <div class="act-icon">🚗</div>
          <div class="act-title">Loueurs de véhicules</div>
          <div class="act-desc">Location courte et longue durée.</div>
          <span class="act-link">En savoir plus <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
        </a>

        <div class="act-card reveal" style="transition-delay:.2s">
          <div class="act-icon">🚛</div>
          <div class="act-title">Dépanneurs</div>
          <div class="act-desc">Remorquage et assistance routière.</div>
        </div>

        <div class="act-card reveal" style="transition-delay:.05s">
          <div class="act-icon">⛽</div>
          <div class="act-title">Stations-services</div>
          <div class="act-desc">Distribution de carburant et services associés.</div>
        </div>

        <div class="act-card reveal" style="transition-delay:.1s">
          <div class="act-icon">🔬</div>
          <div class="act-title">Centres techniques</div>
          <div class="act-desc">Contrôle technique et diagnostics véhicule.</div>
        </div>

        <a href="{{ path('app_negociants') }}" class="act-card reveal" style="transition-delay:.15s">
          <div class="act-icon">🤝</div>
          <div class="act-title">Négociants auto</div>
          <div class="act-desc">Achat et revente de véhicules d'occasion.</div>
          <span class="act-link">En savoir plus <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
        </a>

        <a href="{{ path('app_auto_ecole') }}" class="act-card reveal" style="transition-delay:.2s">
          <div class="act-icon">📚</div>
          <div class="act-title">Auto-écoles</div>
          <div class="act-desc">Enseignement de la conduite et formation.</div>
          <span class="act-link">En savoir plus <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
        </a>
        

      </div>
    </div>
  </section>

  {# ── Guarantees ── #}
  <section class="guarantees-section" id="garanties">
    <div class="section">
      <div class="section-head reveal">
        <span class="stag">Couvertures</span>
        <h2>Garanties assurance pro de l'auto</h2>
        <p>Les principales garanties que peut inclure votre contrat d'assurance multirisque professionnelle.</p>
      </div>

      <div class="g-grid">

        <div class="g-card reveal" style="transition-delay:.05s">
          <div class="g-card-inner">
            <div class="g-front">
              <div class="g-icon-wrap">🛡️</div>
              <h3>Responsabilité civile professionnelle</h3>
              <div class="g-front-hint"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 10l5 5 5-5"/></svg> Survolez pour en savoir plus</div>
            </div>
            <div class="g-back">
              <div class="g-back-icon">🛡️</div>
              <h3>RC Professionnelle</h3>
              <p>Protège contre les dommages corporels ou matériels causés à des tiers dans le cadre de votre activité.</p>
            </div>
          </div>
        </div>

        <div class="g-card reveal" style="transition-delay:.1s">
          <div class="g-card-inner">
            <div class="g-front">
              <div class="g-icon-wrap">🏗️</div>
              <h3>Assurance des biens</h3>
              <div class="g-front-hint"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 10l5 5 5-5"/></svg> Survolez pour en savoir plus</div>
            </div>
            <div class="g-back">
              <div class="g-back-icon">🏗️</div>
              <h3>Assurance des biens</h3>
              <p>Couvre les dommages ou la perte de vos équipements, outils et installations professionnels.</p>
            </div>
          </div>
        </div>

        <div class="g-card reveal" style="transition-delay:.15s">
          <div class="g-card-inner">
            <div class="g-front">
              <div class="g-icon-wrap">🔧</div>
              <h3>RC garage</h3>
              <div class="g-front-hint"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 10l5 5 5-5"/></svg> Survolez pour en savoir plus</div>
            </div>
            <div class="g-back">
              <div class="g-back-icon">🔧</div>
              <h3>RC garage</h3>
              <p>Spécifique aux ateliers, offre une protection contre les dommages causés aux véhicules des clients.</p>
            </div>
          </div>
        </div>

        <div class="g-card reveal" style="transition-delay:.05s">
          <div class="g-card-inner">
            <div class="g-front">
              <div class="g-icon-wrap">🚘</div>
              <h3>Assurance véhicule propre</h3>
              <div class="g-front-hint"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 10l5 5 5-5"/></svg> Survolez pour en savoir plus</div>
            </div>
            <div class="g-back">
              <div class="g-back-icon">🚘</div>
              <h3>Véhicule propre</h3>
              <p>Protège les véhicules appartenant directement au professionnel dans le cadre de son activité.</p>
            </div>
          </div>
        </div>

        <div class="g-card reveal" style="transition-delay:.1s">
          <div class="g-card-inner">
            <div class="g-front">
              <div class="g-icon-wrap">📋</div>
              <h3>Responsabilité des produits</h3>
              <div class="g-front-hint"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 10l5 5 5-5"/></svg> Survolez pour en savoir plus</div>
            </div>
            <div class="g-back">
              <div class="g-back-icon">📋</div>
              <h3>Responsabilité produits</h3>
              <p>Pour les fabricants ou vendeurs de pièces, couvre les dommages causés par des défauts de fabrication.</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  {# ── CTA Banner ── #}
  <section class="cta-wrap">
    <div class="section">
      <div class="cta-box reveal">
        <p style="font-size:.72rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.4);margin-bottom:.75rem">Devis RC pro</p>
        <h2>Devis RC pro pour professionnel auto</h2>
        <p>
          Choisissez des polices d'assurance adaptées aux risques spécifiques de votre activité, pour une protection complète et sans mauvaise surprise.
        </p>
        <a href="#main-content" class="btn-primary">
          <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          Obtenir mon devis gratuit
        </a>
      </div>
    </div>
  </section>

  {% include 'partials/cookie_banner.html.twig' %}
</main>

{{ include('partials/footer.html.twig') }}

<script>
function initReveal() {
  const io = new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.07 });
  document.querySelectorAll('.reveal').forEach(el => io.observe(el));
}
document.addEventListener('DOMContentLoaded', initReveal);
document.addEventListener('turbo:load', initReveal);
</script>

{% endblock %}