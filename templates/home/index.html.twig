{% extends 'base.html.twig' %}

{% block title %}Aksam Assurance — Assurance Professionnels Auto{% endblock %}

{% block body %}
    {{ include('partials/header.html.twig') }}    
    <main id="main-content" class="flex-1">
        {# Hero Section #}
        <section class="relative min-h-[calc(100vh-4rem)] flex items-center overflow-hidden">
            <div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-center">
                    <div class="lg:col-span-6 lg:col-start-1 order-2 lg:order-1">
                        <div class="relative h-full min-h-[320px] sm:min-h-[440px] lg:min-h-[560px] rounded-2xl lg:rounded-3xl overflow-hidden shadow-2xl">
                            <img src="https://assurance-professionnels-auto.fr/image/photo.jpg" alt="Conducteur professionnel" class="w-full h-full object-cover object-center" loading="lazy" />
                        </div>
                    </div>
  <div class="lg:col-span-5 lg:col-start-7 order-1 lg:order-2">
                        <div class="glass-effect rounded-3xl p-5 md:p-6 shadow-2xl shadow-indigo-500/10">
                            
                            
                            {{ include('partials/form_partial.html.twig', {
                                'form': form,
                                'title': null,
                                'subtitle': null,
                                'showActivity': true,
                                'showPostalCode': true
                            }) }}
                        </div>
                        
                    </div>
                </div>
            </div>
        </section>

        {# Insurance Info Section #}
        <section class="py-16 bg-white glass-section">
            <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
                <div class="inline-flex items-center gap-2 px-4 py-2 bg-white rounded-full shadow-sm border border-gray-200 mb-6">
                    <span class="w-2 h-2 bg-indigo-500 rounded-full"></span>
                    <span class="text-sm font-medium text-indigo-700">Notre expertise</span>
                </div>
                
                <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-5 font-display">
                    Assurance des professionnels de l'automobile
                </h2>
                <p class="text-base md:text-lg text-gray-600 leading-relaxed max-w-3xl mx-auto">
                    L'assurance des professionnels de l'automobile est une forme d'assurance conçue spécialement pour les entreprises et les professionnels travaillant dans le secteur automobile. Cette assurance multimrisque professionnelle vise à protéger les professionnels de l'automobile contre les risques spécifiques liés à leurs activités.
                </p>
            </div>
        </section>

        {% include 'partials/activity_section.html.twig' %}

        {% include 'partials/guarantee_section.html.twig' %}

        {% include 'partials/cta_section.html.twig' %}

        {% include 'partials/cookie_banner.html.twig' %}
    </main>

    {{ include('partials/footer.html.twig') }}
{% endblock %}