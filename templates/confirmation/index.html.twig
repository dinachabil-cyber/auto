{% extends 'base.html.twig' %}

{% block title %}Merci pour votre demande ! - Aksam Assurance{% endblock %}

{% block body %}
    <div class="min-h-screen bg-gradient-to-br from-light via-surfaceHover to-light hero-pattern py-12 sm:py-20">
        <div class="container mx-auto px-4">
            <div class="max-w-2xl mx-auto bg-surface rounded-3xl shadow-2xl p-6 sm:p-12 text-center border border-yellow-200">

                <h1 class="text-2xl sm:text-3xl font-bold text-gradient mb-4 sm:mb-6">
                    Merci pour votre demande !
                </h1>

                {# Description #}
                <p class="text-base sm:text-xl text-gray-700 leading-relaxed mb-6 sm:mb-8">
                    Votre demande de devis a été enregistrée avec succès.
                    Nos conseillers vont l'analyser et vous contacter
                    dans les plus brefs délais pour vous fournir les meilleures offres
                    d'assurance adaptées à votre situation.
                </p>

                {# Contact Box #}
                <div class="bg-gradient-to-r from-yellow-50 to-yellow-100 rounded-2xl p-4 sm:p-6 mb-6 sm:mb-8 border border-yellow-200">
                    <p class="text-gray-800 font-semibold text-base sm:text-lg">
                        Besoin d'une réponse rapide ?
                    </p>

                    <p class="text-gray-600 mt-2 sm:mt-3">
                        Contactez-nous directement au{' '}
                        <a href="tel:0182834800" class="text-orange-500 font-bold hover:text-orange-600 transition-colors">
                            01 82 83 48 00
                        </a>
                    </p>
                </div>

                {# Button #}
                <a href="{{ path('app_home') }}" class="inline-flex items-center justify-center gap-2 sm:gap-3 bg-white text-[#312a8b] font-bold py-3 sm:py-4 px-6 sm:px-10 rounded-2xl hover:bg-indigo-50 transition-all transform hover:scale-105 shadow-2xl cursor-pointer">
                    <svg class="w-4 h-4 sm:w-5 sm:h-5" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M15 10H5M5 10L10 5M5 10L10 15" stroke="#312a8b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    Retour à l'accueil
                </a>

            </div>
        </div>
    </div>
{% endblock %}